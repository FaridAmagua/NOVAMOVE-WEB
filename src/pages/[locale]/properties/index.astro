---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t, supportedLocales, type Locale } from '../../../utils/i18n';
import {
  formatPrice,
  statusLabel,
} from '../../../data/properties';
import { getProperties, getUniqueZones, zoneLabel } from '../../../data/property-source';

export async function getStaticPaths() {
  return supportedLocales.map(locale => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;

// Fuente única: Nivora en producción, fixture en dev (lanza error si falla en prod)
const { properties } = await getProperties();
const uniqueZones = await getUniqueZones();

const destinationFilter = Astro.url.searchParams.get('dest') ?? '';
const sort = Astro.url.searchParams.get('sort') ?? 'featured';

let filtered = properties;
if (destinationFilter) {
  filtered = filtered.filter((p) => p.destination === destinationFilter);
}

if (sort === 'price-asc') {
  filtered = [...filtered].sort((a, b) => a.price - b.price);
} else if (sort === 'price-desc') {
  filtered = [...filtered].sort((a, b) => b.price - a.price);
} else {
  filtered = [...filtered].sort(
    (a, b) => Number(!!b.featured) - Number(!!a.featured)
  );
}
---

<BaseLayout
  title={t(locale, 'properties.title')}
  description={t(locale, 'properties.subtitle')}
  transparentHeader={false}
>
  <section class="properties-listing">
    <div class="container properties-listing__inner">
      <!-- Filters -->
      <form class="properties-toolbar" method="get" aria-label={locale === 'es' ? 'Filtros' : 'Filters'}>
        <div class="properties-toolbar__field">
          <label for="dest">
            {t(locale, 'properties.filterDestination')}
          </label>
          <select name="dest" id="dest" onchange="this.form.submit()">
            <option value="">{t(locale, 'properties.filterAll')}</option>
            {uniqueZones.map((id) => (
              <option value={id} selected={destinationFilter === id}>{zoneLabel(id, locale)}</option>
            ))}
          </select>
        </div>

        <div class="properties-toolbar__field">
          <label for="sort">
            {t(locale, 'properties.sortBy')}
          </label>
          <select name="sort" id="sort" onchange="this.form.submit()">
            <option value="featured" selected={sort === 'featured'}>{t(locale, 'properties.sortDefault')}</option>
            <option value="price-asc" selected={sort === 'price-asc'}>{t(locale, 'properties.sortPriceAsc')}</option>
            <option value="price-desc" selected={sort === 'price-desc'}>{t(locale, 'properties.sortPriceDesc')}</option>
          </select>
        </div>

        {destinationFilter && (
          <a href={`/${locale}/properties/`} class="properties-toolbar__reset">
            × {t(locale, 'properties.filterReset')}
          </a>
        )}
      </form>

      {filtered.length === 0 ? (
        <p class="text-center text-text-secondary py-16 text-lg">{t(locale, 'properties.noResults')}</p>
      ) : (
        <div class="properties-grid" data-stagger data-stagger-step="80">
          {filtered.map((p) => {
            // Nivora = solo alquiler larga duración
            const ctaLabel = locale === 'es' ? 'Ver propiedad' : 'View property';
            const targetPath = `/${locale}/properties/${p.slug}/`;
            const zone = zoneLabel(p.destination, locale);
            const location = p.location[locale]?.trim();
            const showLocation = Boolean(location && location.localeCompare(zone, undefined, { sensitivity: 'base' }) !== 0);
            return (
              <article class="property-result reveal reveal--fade" data-tilt="3">
                <a href={targetPath} class="property-result__link">
                  <figure class="property-result__media">
                    <img
                      src={p.cardImages?.[0] ?? p.images[0]}
                      alt={p.name[locale]}
                      loading="lazy"
                      style={`object-position: ${p.imagePosition ?? 'center 62%'};`}
                    />
                    <span class="absolute top-4 left-4 bg-white/95 text-navy text-[0.7rem] font-semibold tracking-[0.12em] uppercase px-3.5 py-1.5 rounded-full">
                      {statusLabel(p.status, locale)}
                    </span>
                    {p.featured && (
                      <span class="absolute top-4 right-4 bg-gold text-navy text-[0.7rem] font-bold tracking-[0.1em] uppercase px-3.5 py-1.5 rounded-full">
                        ★ {locale === 'es' ? 'Destacada' : 'Featured'}
                      </span>
                    )}
                    <span class={`absolute bottom-4 left-4 text-[0.7rem] font-bold tracking-[0.16em] uppercase px-3.5 py-1.5 rounded-full ${
                      p.status === 'available'
                        ? 'bg-navy/85 text-gold-soft'
                        : 'bg-gold text-navy'
                    }`}>
                      {p.status === 'available'
                        ? (locale === 'es' ? 'Disponible' : 'Available')
                        : (locale === 'es' ? 'Reservado' : 'Reserved')}
                    </span>
                    <figcaption>{p.name[locale]}</figcaption>
                  </figure>
                  <div class="property-result__body">
                    <div class="property-result__location flex gap-2 text-[0.78rem] text-gold font-semibold tracking-[0.08em] uppercase mb-2">
                      <span>{zone}</span>
                      {showLocation && <span>·</span>}
                      {showLocation && <span>{location}</span>}
                    </div>
                    <h3 class="font-sans text-[1.45rem] leading-tight text-navy mb-2">{p.name[locale]}</h3>
                    <p class="text-[0.9rem] text-text-secondary leading-relaxed mb-4 min-h-[2.7em]">{p.tagline[locale]}</p>
                    {(p.bedrooms || p.bathrooms || p.sizeM2) && (
                      <div class="property-result__specs flex gap-2 text-[0.82rem] text-text-secondary pb-4 border-b border-navy/5 mb-4">
                        {p.bedrooms && <span>{p.bedrooms} {t(locale, 'common.bedrooms')}</span>}
                        {p.bedrooms && p.bathrooms && <span>·</span>}
                        {p.bathrooms && <span>{p.bathrooms} {t(locale, 'common.bathrooms')}</span>}
                        {(p.bedrooms || p.bathrooms) && p.sizeM2 && <span>·</span>}
                        {p.sizeM2 && <span>{p.sizeM2} m²</span>}
                      </div>
                    )}
                    <div class="property-result__price flex items-baseline gap-2 flex-wrap">
                      <span class="text-[0.75rem] text-text-secondary uppercase tracking-[0.1em]">{t(locale, 'common.from')}</span>
                      <span class="font-sans text-2xl text-gold font-medium">{formatPrice(p.price, locale)}</span>
                      <span class="text-[0.82rem] text-text-secondary">/{locale === 'es' ? 'mes' : 'month'}</span>
                    </div>
                    <span class="block mt-4 text-gold text-[0.78rem] font-semibold tracking-[0.12em] uppercase transition-all duration-300 group-hover:tracking-[0.16em]">
                      {ctaLabel} →
                    </span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .properties-listing {
    padding: calc(var(--header-height, 92px) + clamp(2rem, 4vw, 3rem)) 0 clamp(3.75rem, 7vw, 6.5rem);
    background: var(--color-white);
  }

  .properties-listing__inner {
    max-width: 1360px;
  }

  .properties-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    padding: 1rem;
    border-radius: 8px;
    background: #f7f7f7;
  }

  .properties-toolbar__field {
    display: flex;
    flex: 1 1 180px;
    flex-direction: column;
    gap: 0.45rem;
  }

  .properties-toolbar label {
    color: var(--custom-blue-color);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .properties-toolbar select {
    min-height: 42px;
    padding: 0.62rem 0.85rem;
    border: 1px solid rgba(0, 26, 114, 0.14);
    border-radius: 999px;
    background: var(--color-white);
    color: #001a72;
    font-size: 0.9rem;
    font-weight: 700;
    outline: none;
  }

  .properties-toolbar__reset {
    padding: 0.78rem 0.9rem;
    color: #001a72;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .properties-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.6rem, 3vw, 2.4rem);
  }

  .property-result {
    color: #000;
  }

  .property-result__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .property-result__media {
    position: relative;
    aspect-ratio: 1.48 / 1;
    margin: 0 0 1.08rem;
    overflow: hidden;
    border-radius: 8px;
    background: #e7e7e7;
  }

  .property-result__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .property-result:hover .property-result__media img {
    transform: scale(1.035);
  }

  .property-result__media > span {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    padding: 0.5rem 0.92rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.94);
    color: #001a72;
    font-size: 0.82rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .property-result__media > span:not(:first-of-type) {
    display: none;
  }

  .property-result__media figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: 86%;
    padding: 0.72rem 1.05rem 0.78rem;
    border-top-right-radius: 999px;
    background: #000;
    color: #fff;
    font-size: clamp(1rem, 1.22vw, 1.22rem);
    font-weight: 800;
    line-height: 1.12;
  }

  .property-result__body {
    display: flex;
    flex-direction: column;
    color: #000;
  }

  .property-result__body > h3,
  .property-result__body > p,
  .property-result__body > span {
    display: none;
  }

  .property-result__location {
    order: 2;
    display: block;
    margin: 0 0 1rem;
    color: #000;
    font-size: clamp(1rem, 1.18vw, 1.18rem);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: 0;
    text-transform: none;
  }

  .property-result__specs {
    order: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 0.48rem 0.82rem;
    padding: 0;
    border: 0;
    margin: 0;
    color: #000;
    font-size: clamp(0.78rem, 0.9vw, 0.9rem);
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .property-result__specs span {
    display: inline-flex;
    align-items: center;
  }

  .property-result__price {
    order: 1;
    display: block;
    margin: 0 0 0.45rem;
  }

  .property-result__price span:first-child,
  .property-result__price span:last-child {
    display: none;
  }

  .property-result__price span:nth-child(2) {
    color: #000;
    font-size: clamp(1.1rem, 1.38vw, 1.34rem);
    font-weight: 900;
    line-height: 1.18;
  }

  @media (max-width: 960px) {
    .properties-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .properties-listing {
      padding: calc(var(--header-height, 72px) + 1.55rem) 0 3.5rem;
    }

    .properties-toolbar {
      gap: 0.8rem;
      margin-bottom: 1.7rem;
      padding: 0.75rem;
    }

    .properties-toolbar__field {
      flex-basis: 100%;
    }

    .properties-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .property-result__media {
      aspect-ratio: 1.42 / 1;
      margin-bottom: 1.15rem;
    }

    .property-result__media > span {
      top: 0.9rem;
      left: 0.9rem;
      padding: 0.5rem 0.88rem;
      font-size: 0.78rem;
    }

    .property-result__media figcaption {
      max-width: 88%;
      padding: 0.74rem 1rem 0.82rem;
      font-size: clamp(1rem, 5.2vw, 1.42rem);
    }

    .property-result__price span:nth-child(2) {
      font-size: clamp(1.04rem, 5vw, 1.32rem);
    }

    .property-result__location {
      font-size: clamp(1rem, 4.7vw, 1.25rem);
      line-height: 1.28;
    }

    .property-result__specs {
      gap: 0.52rem 0.8rem;
      font-size: clamp(0.78rem, 3.8vw, 0.98rem);
    }
  }
</style>
