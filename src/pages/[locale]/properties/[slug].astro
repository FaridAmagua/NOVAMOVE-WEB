---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { t, supportedLocales, type Locale } from '../../../utils/i18n';
import {
  propertyTypeLabel,
  statusLabel,
  formatPrice,
} from '../../../data/properties';
import { getProperties, zoneLabel, type Property } from '../../../data/property-source';

export async function getStaticPaths() {
  const { properties } = await getProperties();
  const paths: Array<{ params: { locale: string; slug: string; }; props: { property: Property; otherProps: Property[] } }> = [];
  for (const locale of supportedLocales) {
    for (const p of properties) {
      // related: misma zone (libre, ya no es enum cerrado)
      const otherProps = properties
        .filter((x) => x.destination === p.destination && x.id !== p.id)
        .slice(0, 3);
      paths.push({ params: { locale, slug: p.slug }, props: { property: p, otherProps } });
    }
  }
  return paths;
}

const { property, otherProps } = Astro.props as { property: Property; otherProps: Property[] };
const locale = Astro.params.locale as Locale;
const propMenuItems = [
  { label: t(locale, 'nav.services'), href: `/${locale}/services/` },
  { label: t(locale, 'nav.destinations'), href: `/${locale}/destinations/` },
  { label: t(locale, 'nav.properties'), href: `/${locale}/properties/` },
  { label: t(locale, 'nav.about'), href: `/${locale}/about/` },
  { label: t(locale, 'nav.blog'), href: `/${locale}/blog/` },
  { label: t(locale, 'nav.contact'), href: `/${locale}/contact/` },
];

// Nivora = solo alquiler larga duración. CTA = "Solicitar información".
// Versión de precio: €/mes (Nivora envía amountCents/mes).
const priceUnit = `/${locale === 'es' ? 'mes' : 'month'}`;
const ctaLabel = t(locale, 'properties.requestInfo');
const whatsappNumber = '34601518207';
const whatsappMessage = locale === 'es'
  ? `Hola, me interesa la propiedad ${property.name.es} (${property.reference}). ¿Podéis darme más información?`
  : `Hello, I am interested in ${property.name.en} (${property.reference}). Could you send me more information?`;
const ctaHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
const visitLabel = locale === 'es' ? 'Concertar visita' : 'Schedule a viewing';
const visitHref = `/${locale}/book/${property.slug}/`;
const availabilitySource = property as Property & {
  availableFrom?: string | null;
  availability?: { availableFrom?: string | null } | null;
};
const availableFromRaw = availabilitySource.availableFrom ?? availabilitySource.availability?.availableFrom ?? null;
const availableFromDate = availableFromRaw ? new Date(availableFromRaw) : null;
const showAvailableFrom = Boolean(availableFromDate && !Number.isNaN(availableFromDate.getTime()));
const availableFromLabel = showAvailableFrom && availableFromDate
  ? new Intl.DateTimeFormat(locale === 'es' ? 'es-ES' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(availableFromDate)
  : '';

// Features por idioma: en ES usa features.es; en EN usa features.en con
// fallback a features.es si está vacío.
const features = (() => {
  const es = property.features.es ?? [];
  const enRaw = property.features.en ?? [];
  const en = enRaw.length > 0 ? enRaw : es;
  if (locale === 'es') return es;
  return en;
})();

const destLabel = zoneLabel(property.destination, locale);
const detailedLocation = property.location[locale]?.trim();
const showDetailedLocation = Boolean(
  detailedLocation && detailedLocation.localeCompare(destLabel, undefined, { sensitivity: 'base' }) !== 0
);
const mapLocation = detailedLocation || destLabel;
const mapRadiusKm = Math.min(30, Math.max(0.5, property.map?.radiusKm ?? 3));
const mapZoom = mapRadiusKm <= 1 ? 14 : mapRadiusKm <= 2 ? 13 : mapRadiusKm <= 5 ? 12 : mapRadiusKm <= 10 ? 11 : mapRadiusKm <= 20 ? 10 : 9;
const mapPrecision = property.map?.precision ?? 'neighborhood';
const mapPrecisionLabel = locale === 'es'
  ? ({ street: 'calle aproximada', neighborhood: 'barrio aproximado', area: 'zona aproximada' } as const)[mapPrecision]
  : ({ street: 'approximate street', neighborhood: 'approximate neighbourhood', area: 'approximate area' } as const)[mapPrecision];
const mapSrc = property.lat != null && property.lng != null
  ? `https://maps.google.com/maps?q=${property.lat},${property.lng}&z=${mapZoom}&output=embed`
  : `https://maps.google.com/maps?q=${encodeURIComponent(property.map?.query || mapLocation)}&z=${mapZoom}&output=embed`;
const processSteps = locale === 'es'
  ? [
      ['Solicita información', 'Cuéntanos qué necesitas y resolveremos tus dudas sobre la vivienda.'],
      ['Concertamos una visita', 'Coordinamos contigo el mejor día y hora para conocer la propiedad.'],
      ['Preparamos el alquiler', 'Te acompañamos con las condiciones, documentación y siguientes pasos.'],
    ]
  : [
      ['Request information', 'Tell us what you need and we will answer your questions about the property.'],
      ['Schedule a viewing', 'We coordinate the best day and time for you to visit the property.'],
      ['Prepare the tenancy', 'We guide you through the terms, documents and next steps.'],
    ];

const overviewItems = [
  [locale === 'es' ? 'Tipo de propiedad' : 'Property Type', locale === 'es' ? 'Otro' : 'Other'],
  [locale === 'es' ? 'Ubicación' : 'Location', '21 & 407 Fairfield Pond Ln, Sagaponack, NY 11962'],
  [locale === 'es' ? 'Año de construcción' : 'Year Built', '1998'],
  ['MLS ID', '924260'],
  [locale === 'es' ? 'Última actualización' : 'Listing Last Updated', '9/15/2026 6:03 PM'],
];

const interiorFeatures = [
  [locale === 'es' ? 'Dormitorios totales' : 'Total Bedrooms', property.bedrooms ? String(property.bedrooms) : '8'],
  [locale === 'es' ? 'Baños completos' : 'Full Bathrooms', property.bathrooms ? String(property.bathrooms) : '7'],
  [locale === 'es' ? 'Medios baños' : 'Half Bathrooms', '3'],
  [locale === 'es' ? 'Suelos' : 'Flooring', locale === 'es' ? 'Madera, baldosa, piedra' : 'Hardwood, Tile, Stone'],
  [locale === 'es' ? 'Lavandería' : 'Laundry Room', locale === 'es' ? 'Lavandería' : 'Laundry Room'],
  [locale === 'es' ? 'Chimenea' : 'Fireplace', locale === 'es' ? 'Chimenea' : 'Fireplace'],
  [locale === 'es' ? 'Electrodomésticos' : 'Appliances', locale === 'es' ? 'Lavavajillas, secadora, frigorífico, microondas, horno, electrodomésticos de acero inoxidable, lavadora' : 'Dishwasher, Dryer, Refrigerator, Microwave, Oven, Stainless Steel Appliance(s), Washer'],
  [locale === 'es' ? 'Otras características interiores' : 'Other Interior Features', locale === 'es' ? 'Dormitorio principal, baño en suite, vestidores, sala multimedia, estudio, gimnasio, recibidor, sala familiar, salón, comedor, zona de desayuno' : 'Primary Bedroom, En Suite Bathroom, Walk-In Closet(s), Media Room, Study, Exercise Room, Entrance Foyer, Family Room, Living Room, Great Room, Dining Room, Breakfast Area'],
];

const exteriorFeatures = [
  [locale === 'es' ? 'Plantas' : 'Stories', '2'],
  [locale === 'es' ? 'Plazas de garaje' : 'Garage Spaces', '3.0'],
  [locale === 'es' ? 'Suministro de agua' : 'Water Source', locale === 'es' ? 'Pozo privado' : 'Private Well'],
  [locale === 'es' ? 'Piscina' : 'Pool', locale === 'es' ? 'Gunita, climatizada, enterrada, privada' : 'Gunite, Heated, In Ground, Private'],
  [locale === 'es' ? 'Cubierta' : 'Roof', locale === 'es' ? 'Cedro' : 'Cedar'],
  [locale === 'es' ? 'Características de parcela' : 'Lot Features', locale === 'es' ? 'Calle sin salida, vallada, junto a campo de golf, riego instalado' : 'Cul-De-Sac, Fenced, On Golf Course, Sprinklers In Ground'],
  [locale === 'es' ? 'Aparcamiento' : 'Parking', locale === 'es' ? 'Anexo' : 'Attached'],
  [locale === 'es' ? 'Calefacción' : 'Heat Type', locale === 'es' ? 'Aire forzado, geotermia' : 'Forced Air, Geothermal'],
  [locale === 'es' ? 'Aire acondicionado' : 'Air Conditioning', locale === 'es' ? 'Aire central' : 'Central Air'],
];

const detailFeatures = [
  [locale === 'es' ? 'Barrio' : 'Neighborhood', 'Sagaponack'],
  [locale === 'es' ? 'Estilo arquitectónico' : 'Architecture Styles', locale === 'es' ? 'Contemporáneo' : 'Contemporary'],
  [locale === 'es' ? 'Frente de agua' : 'Water Frontage', locale === 'es' ? 'Frente al océano, waterfront' : 'Ocean Front, Waterfront'],
  [locale === 'es' ? 'Vistas' : 'View Description', locale === 'es' ? 'Océano, agua' : 'Ocean, Water'],
];

const financialFeatures = [
  [locale === 'es' ? 'Precio' : 'Price', '$89,000,000'],
];

// Amenity icon SVGs (custom, monoline, fit Montserrat aesthetic)
const amenityIcons: Record<string, string> = {
  pool:        '<path d="M2 18c1.5 0 1.5-1 3-1s1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1"/><path d="M6 14V9a3 3 0 0 1 6 0v5"/><path d="M12 10c1.5 0 1.5-1 3-1s1.5 1 3 1"/><path d="M12 6c1.5 0 1.5-1 3-1s1.5 1 3 1"/>',
  wifi:        '<path d="M5 12.55a11 11 0 0 1 14 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0"/><circle cx="12" cy="20" r="1.5"/>',
  ac:          '<path d="M3 7v10M21 7v10M3 12h18M7 5h10M7 19h10"/>',
  parking:     '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 17V7h5a3 3 0 0 1 0 6h-5"/>',
  kitchen:     '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M3 7l3-4h12l3 4M7 12v4M11 12v4M15 12v4M17 12v4"/>',
  'sea-view':  '<path d="M2 18c3 0 3-2 6-2s3 2 6 2 3-2 6-2"/><path d="M2 14c3 0 3-2 6-2s3 2 6 2 3-2 6-2"/><circle cx="17" cy="5" r="2.5"/>',
  'city-view': '<path d="M3 21h18M5 21V8h4v13M11 21V4h4v17M17 21v-9h4v9"/>',
  garden:      '<path d="M12 2v8m-7-3l5 5m9-5l-5 5M5 14c0 4 3 7 7 7s7-3 7-7"/>',
  terrace:     '<rect x="3" y="9" width="18" height="9" rx="1"/><path d="M3 9l9-6 9 6M8 14h2M14 14h2"/>',
  jacuzzi:     '<circle cx="12" cy="12" r="9"/><circle cx="9" cy="11" r="0.8"/><circle cx="13" cy="10" r="0.8"/><circle cx="15" cy="13" r="0.8"/>',
  gym:         '<path d="M2 12h2M20 12h2M6 8v8M18 8v8M6 12h12"/>',
  cinema:      '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9h18M8 5v14M16 5v14"/>',
  bbq:         '<rect x="3" y="9" width="18" height="11" rx="1"/><path d="M8 9V5a4 4 0 0 1 8 0v4M12 13v-2"/>',
  fireplace:   '<path d="M5 21h14M5 21V8h5l2-3 2 3h5v13M12 14c-2 0-3 2-3 4s2 2 3 2 3 0 3-2-1-4-3-4z"/>',
  'beach-access': '<path d="M3 14c1.5-2 4-2 6 0s4.5 2 6 0 4-2 6 0M2 18h20M12 4v3M11 4h2"/>',
  concierge:   '<circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2"/>',
  elevator:    '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 8v4M9 11l3-3 3 3M9 16l3 3 3-3M8 6h8"/>',
};

const genericFeatureIcon = '<circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/>';
const featureIconAliases: Array<[string[], string]> = [
  [['piscina', 'pool'], 'pool'], [['wifi', 'wi-fi'], 'wifi'],
  [['aire acondicionado', 'air conditioning'], 'ac'], [['garaje', 'parking', 'aparcamiento'], 'parking'],
  [['cocina', 'kitchen'], 'kitchen'], [['vista al mar', 'vistas al mar', 'sea view'], 'sea-view'],
  [['vista a la ciudad', 'vistas a la ciudad', 'city view'], 'city-view'], [['jardin', 'garden'], 'garden'],
  [['terraza', 'terrace'], 'terrace'], [['jacuzzi'], 'jacuzzi'], [['gimnasio', 'gym'], 'gym'],
  [['cine', 'cinema'], 'cinema'], [['barbacoa', 'bbq'], 'bbq'], [['chimenea', 'fireplace'], 'fireplace'],
  [['playa', 'beach access'], 'beach-access'], [['portero', 'conserje', 'concierge'], 'concierge'],
  [['ascensor', 'elevator'], 'elevator'],
];
function featureIcon(feature: string) {
  const normalized = feature.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const alias = featureIconAliases.find(([terms]) => terms.some((term) => normalized.includes(term)));
  return alias ? amenityIcons[alias[1]] : genericFeatureIcon;
}
---

<BaseLayout
  title={property.name[locale]}
  description={property.tagline[locale]}
  transparentHeader={true}
>
  <!-- =======================================================
       Hero: Gallery + Title (top section, full bleed)
       ======================================================= -->
  <section class="prop-gallery-wrap">
    <div class="prop-detail-nav" aria-label={locale === 'es' ? 'Navegación de propiedad' : 'Property navigation'}>
      <a href={`/${locale}/`} class="prop-detail-nav__wordmark" aria-label="Global Move - Inicio">
        <img src="/brand/global-move-icon-gold.png" alt="" width="512" height="512" aria-hidden="true" />
        <span>GLOBAL.MOVE</span>
      </a>
      <div class="prop-detail-nav__actions">
        <a class="prop-detail-nav__icon" href={`/${locale}/properties/`} aria-label={locale === 'es' ? 'Buscar propiedades' : 'Search properties'}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </a>
        <button class="prop-detail-nav__icon prop-detail-nav__toggle site-header__toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="prop-detail-menu" data-prop-menu-toggle>
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
    <div id="prop-detail-menu" class="prop-detail-menu" aria-hidden="true" data-prop-menu>
      <nav class="prop-detail-menu__nav" aria-label={locale === 'es' ? 'Menú de propiedad' : 'Property menu'}>
        {propMenuItems.map(item => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </div>
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="prop-breadcrumb reveal" aria-label="Breadcrumb">
        <a href={`/${locale}/`}>{t(locale, 'properties.breadcrumbHome')}</a>
        <span aria-hidden="true">›</span>
        <a href={`/${locale}/properties/`}>{t(locale, 'properties.breadcrumbProperties')}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{property.name[locale]}</span>
      </nav>

      <!-- Gallery -->
      <div class="prop-gallery reveal">
        <div
          class="prop-gallery__main"
          data-lightbox-trigger="property"
          data-lightbox-group="property"
          role="button"
          tabindex="0"
          aria-label={locale === 'es' ? 'Ver fotos en pantalla completa' : 'View photos fullscreen'}
        >
          <span class="prop-gallery__signature">{locale === 'es' ? 'GLOBAL.MOVE Selección' : 'GLOBAL.MOVE Signature'}</span>
          <img src={property.images[0]} alt={property.name[locale]} loading="eager" fetchpriority="high"
               style={`object-position: ${property.imagePositions?.[0] ?? property.imagePosition ?? '50% 50%'};`} />
          <span class={`prop-gallery__badge prop-gallery__badge--${property.status === 'available' ? 'rent' : 'sale'}`}>
            {property.status === 'available' ? (locale === 'es' ? 'Alquiler' : 'Rent') : statusLabel(property.status, locale)}
          </span>
          <span class="prop-gallery__zoom" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7"/>
              <path d="m21 21-4.3-4.3M11 8v6M8 11h6"/>
            </svg>
          </span>
        </div>
        <div class="prop-gallery__thumbs">
          {property.images.slice(1, 5).map((img, index) => (
            <div class="prop-gallery__thumb" data-lightbox-trigger="property" data-lightbox-group="property" role="button" tabindex="0" aria-label="Ver foto">
              <img src={img} alt="" loading="lazy" style={`object-position: ${property.imagePositions?.[index + 1] ?? '50% 50%'};`} />
            </div>
          ))}
          {property.images.length < 5 && Array.from({ length: 5 - property.images.length }).map(() => (
            <div class="prop-gallery__thumb prop-gallery__thumb--placeholder">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <circle cx="9" cy="9" r="2"/>
                <path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>
              </svg>
            </div>
          ))}
        </div>
      </div>
      {property.images.length > 5 && <div class="prop-gallery-extra" aria-label={locale === 'es' ? 'Más fotografías de la propiedad' : 'More property photos'}>
        {property.images.slice(5).map((img, index) => (
          <button class="prop-gallery-extra__item" type="button" data-lightbox-trigger="property" data-lightbox-group="property" aria-label={locale === 'es' ? `Ver fotografía ${index + 6}` : `View photo ${index + 6}`}>
            <img src={img} alt={`${property.name[locale]} · ${index + 6}`} loading="lazy" style={`object-position: ${property.imagePositions?.[index + 5] ?? '50% 50%'};`} />
          </button>
        ))}
      </div>}
    </div>
  </section>

  <!-- =======================================================
       Body: Title + Specs + Sidebar CTA + Inquiry form
       ======================================================= -->
  <section class="section prop-body">
    <div class="container">
      <div class="prop-layout">
        <!-- ============ MAIN COLUMN ============ -->
        <div class="prop-main">

          <!-- Title -->
          <header class="prop-title-block reveal">
            <div class="prop-title-block__meta">
              <span class="prop-title-block__type">{propertyTypeLabel(property.type, locale)}</span>
              <span class="prop-title-block__dot">·</span>
              <a href={`/${locale}/properties/?dest=${property.destination}`} class="prop-title-block__city">{destLabel}</a>
              {showDetailedLocation && <span class="prop-title-block__dot">·</span>}
              {showDetailedLocation && <span>{detailedLocation}</span>}
              {property.reference && (
                <>
                  <span class="prop-title-block__dot">·</span>
                  <span class="prop-title-block__reference">Ref. {property.reference}</span>
                </>
              )}
            </div>
            {property.status === 'available' && (
              <span class="prop-title-block__status">{statusLabel(property.status, locale)}</span>
            )}
            <h1 class="prop-title-block__title">{property.name[locale]}</h1>
            <p class="prop-title-block__tagline">{property.tagline[locale]}</p>
          </header>

          <section class="prop-mobile-summary reveal" aria-label={locale === 'es' ? 'Resumen de la propiedad' : 'Property overview'}>
            <p>{mapLocation}</p>
            <strong>{formatPrice(property.price, locale)}<span>{priceUnit}</span></strong>
          </section>

          <!-- Quick specs horizontal bar -->
          {(property.bedrooms || property.bathrooms || property.sizeM2) && <div class="prop-quick-specs reveal">
            {property.bedrooms && <div class="prop-quick-spec">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
              <span><strong>{property.bedrooms}</strong> BEDS</span>
            </div>}
            {property.bathrooms && <div class="prop-quick-spec">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M9 6L6 18h12l-3-12M9 6V4a3 3 0 0 1 6 0v2M5 21h14"/>
              </svg>
              <span><strong>{property.bathrooms}</strong> FULL BATHS</span>
            </div>}
            <div class="prop-quick-spec">
              <span><strong>3</strong> HALF BATHS</span>
            </div>
            {property.sizeM2 && <div class="prop-quick-spec">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <path d="M3 10h18"/>
              </svg>
              <span><strong>{property.sizeM2}</strong> SQ.FT.</span>
            </div>}
            <div class="prop-quick-spec prop-quick-spec--status">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
              <span class={property.status === 'available' ? 'text-emerald-700' : 'text-amber-700'}>
                {statusLabel(property.status, locale)}
              </span>
            </div>
          </div>}

          <button type="button" class="prop-share-button reveal" data-property-share aria-label={locale === 'es' ? 'Compartir propiedad' : 'Share property'}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <path d="M8.7 10.7 15.3 6.3"></path>
              <path d="M8.7 13.3 15.3 17.7"></path>
            </svg>
            <span>{locale === 'es' ? 'Compartir' : 'Share'}</span>
          </button>

          <div class="prop-mobile-actions reveal">
            <a href="#get-in-touch">{locale === 'es' ? 'Contactar' : 'Get in Touch'}</a>
            <a href="#tour-card">{locale === 'es' ? 'Agendar visita' : 'Schedule a Tour'}</a>
          </div>

          <!-- Description with collapse -->
          <section class="prop-section prop-section--description reveal">
            <details class="prop-mobile-accordion" open>
              <summary>
                <span>
                  <span class="label-desktop">{t(locale, 'properties.highlights')}</span>
                  <span class="label-mobile">{locale === 'es' ? 'Descripción de la propiedad' : 'Property Description'}</span>
                </span>
                <span class="prop-mobile-accordion__icon" aria-hidden="true"></span>
              </summary>
              <div class="prop-description" data-description-collapse>
                <p class="prop-description__text">{property.description[locale]}</p>
                <p class="prop-description__extra" hidden>
                  {locale === 'es'
                    ? `Una propiedad única en ${destLabel}, gestionada por Global Move con los más altos estándares de calidad. Cada detalle ha sido cuidado para ofrecer una experiencia memorable a nuestros clientes. La vivienda combina espacios interiores amplios, zonas exteriores pensadas para disfrutar todo el año y una ubicación cómoda para acceder a restaurantes, servicios, playa y los principales puntos de interés de la zona.`
                    : `A unique property in ${destLabel}, managed by Global Move with the highest standards of quality. Every detail has been carefully curated to deliver a memorable experience to our clients. The home combines generous interior spaces, outdoor areas designed for year-round living, and a convenient location close to restaurants, services, the beach, and the area's main points of interest.`}
                </p>
                <button type="button" class="prop-description__read-more" data-description-toggle>
