    counter-reset: step;
  }
  .prop-process__step {
    position: relative;
    padding-top: 1.5rem;
  }
  .prop-process__step::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--color-gold) 0%, transparent 80%);
  }
  .prop-process__num {
    display: block;
    font-family: var(--font-sans);
    font-size: 2.25rem;
    color: var(--color-gold);
    line-height: 1;
    font-weight: 700;
    margin-bottom: 1rem;
    letter-spacing: 0;
  }
  .prop-process__step h3 {
    font-family: var(--font-sans);
    font-size: 1.2rem;
    color: var(--color-navy);
    margin-bottom: 0.6rem;
    font-weight: 600;
  }
  .prop-process__step p {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ============ CANCELLATION ============ */
  .prop-cancellation {
    background: var(--color-light);
    padding: 2rem 2.5rem;
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-gold);
  }
  .prop-cancellation h3 {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    color: var(--color-navy);
    margin-bottom: 0.65rem;
    font-weight: 600;
  }
  .prop-cancellation__body {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-primary);
    margin: 0;
  }

  /* ============ INQUIRY FORM STYLES (need to keep existing) ============ */
  .inquiry-form { display: flex; flex-direction: column; }
  .inquiry-form .field { margin-bottom: 1rem; }
  .inquiry-form .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .inquiry-form .field--checkbox { padding: 0.25rem 0; }
  .inquiry-form .field label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy);
    margin-bottom: 0.4rem;
  }
  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-transform: none !important;
    letter-spacing: 0 !important;
    font-size: 0.92rem !important;
    font-weight: 500 !important;
    color: var(--text-primary);
    cursor: pointer;
  }
  .checkbox-label input[type='checkbox'] {
    width: 18px; height: 18px; accent-color: var(--color-gold);
  }
  .inquiry-form__privacy {
    font-size: 0.8rem; color: var(--text-secondary);
    margin: 0.5rem 0 1rem;
  }
  .inquiry-form__submit { width: 100%; }

  /* ============ BOOKING SIDEBAR (mobile-first, sticky on lg+) ============ */
  .prop-layout {
    display: grid;
    /* Mobile (default): single column, booking card below content */
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  /* lg+ : 2 columns with sidebar (Tailwind lg = 1024px) */
  @media (min-width: 1024px) {
    .prop-layout {
      grid-template-columns: 1.65fr 1fr;
      gap: 4rem;
    }
  }
  .prop-sidebar {
    position: static; /* static on mobile so it stacks below */
  }
  @media (min-width: 1024px) {
    .prop-sidebar { position: sticky; top: calc(var(--header-height) + 1.5rem); }
  }
  .booking-card {
    background: var(--color-white);
    border: 1px solid rgba(10, 29, 63, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    text-align: left;
  }
  .booking-card__top {
    padding: 1.25rem; /* mobile */
  }
  @media (min-width: 540px) { .booking-card__top { padding: 1.75rem; } }
  @media (min-width: 1024px) { .booking-card__top { padding: 2rem; } }
  .booking-card__chip {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .booking-card__chip--rent {
    background: var(--color-navy);
    color: var(--color-gold-soft);
  }
  .booking-card__chip--sale {
    background: var(--color-gold);
    color: var(--color-navy);
  }
  .booking-card__price {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    text-align: left;
    width: 100%;
  }
  .booking-card__from {
    font-size: 0.78rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }
  .booking-card__amount {
    font-family: var(--font-sans);
    font-size: 1.85rem; /* mobile */
    color: var(--color-gold);
    font-weight: 700;
    letter-spacing: 0;
    white-space: nowrap;
  }
  @media (min-width: 540px)  { .booking-card__amount { font-size: 2rem; } }
  @media (min-width: 1024px) { .booking-card__amount { font-size: 2.25rem; } }
  .booking-card__unit {
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
  .booking-card__cta { width: 100%; margin-bottom: 1rem; }
  .booking-card__visit-cta {
    background: var(--color-navy);
    color: var(--text-on-dark);
    border-color: var(--color-navy);
    box-shadow: 0 8px 20px rgba(10, 29, 63, 0.14);
  }
  .booking-card__visit-cta:hover {
    background: var(--color-white);
    color: var(--color-navy);
    border-color: var(--color-navy);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }
  .booking-card__note--trust {
    text-align: center;
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.4;
    margin: 0.5rem 0 0;
  }

  /* Inline datepicker (rental bookings) */
  .booking-card__dates {
    margin-bottom: 0;
  }
  .booking-card__field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .booking-card__field {
    margin-bottom: 0.65rem;
  }
  .booking-card__field label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-navy);
    margin-bottom: 0.35rem;
  }
  .booking-card__input {
    width: 100%;
    padding: 0.65rem 0.85rem;
    background: var(--color-white);
    border: 1px solid rgba(10, 29, 63, 0.15);
    border-radius: var(--radius-sm);
    font-size: 0.92rem;
    color: var(--text-primary);
    font-family: inherit;
    transition: border-color var(--dur-base) var(--ease);
    background-color: white;
  }
  .booking-card__input:focus {
    outline: none;
    border-color: var(--color-gold);
  }
  .booking-card__input::-webkit-calendar-picker-indicator {
    filter: invert(0.4);
    cursor: pointer;
  }
  .booking-card__estimate {
    margin: 1rem 0 1.25rem;
    padding: 1rem 1.1rem;
    background: var(--color-white);
    border: 1px dashed rgba(10, 29, 63, 0.18);
    border-radius: var(--radius-md);
    min-height: 60px;
  }
  .booking-card__estimate-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }
  .booking-card__estimate-row:last-of-type { margin-bottom: 0; }
  .booking-card__estimate-row--total {
    border-top: 1px solid rgba(10, 29, 63, 0.12);
    padding-top: 0.6rem;
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-navy);
    margin-bottom: 0;
  }
  .booking-card__estimate-help {
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin: 0;
    line-height: 1.4;
  }

  .booking-card__trust {
    padding: 1.5rem 2rem 2rem;
    background: var(--color-light);
    border-top: 1px solid rgba(10, 29, 63, 0.08);
  }
  .booking-card__trust h4 {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .trust-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .trust-item {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }
  .trust-item svg {
    color: var(--color-gold);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .trust-item strong {
    display: block;
    font-size: 0.88rem;
    color: var(--color-navy);
    font-weight: 600;
    margin-bottom: 2px;
  }
  .trust-item span {
    display: block;
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  /* ============ REVIEWS ============ */
  .prop-reviews__score {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 1rem;
    background: var(--color-light);
    border-radius: var(--radius-md);
  }
  .prop-reviews__score-num {
    font-family: var(--font-sans);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1;
  }
  .prop-reviews__score-meta { display: flex; flex-direction: column; gap: 2px; }
  .prop-reviews__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--color-gold);
  }
  .prop-reviews__score-meta span {
    font-size: 0.7rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }
  .prop-reviews__score-sub { font-size: 0.66rem !important; }
  .prop-section__subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }

  .prop-reviews__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .prop-review {
    background: var(--color-light);
    padding: 1.75rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .prop-review__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--color-gold);
    width: fit-content;
  }
  .prop-review__text {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-primary);
    margin: 0;
    flex: 1;
  }
  .prop-review__footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 1rem;
    border-top: 1px solid rgba(10, 29, 63, 0.08);
    gap: 1rem;
  }
  .prop-review__footer strong {
    display: block;
    font-size: 0.92rem;
    color: var(--color-navy);
    font-weight: 600;
  }
  .prop-review__footer span {
    display: block;
    font-size: 0.78rem;
    color: var(--text-secondary);
  }
  .prop-review__date {
    font-size: 0.72rem !important;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ============ RELATED GRID ============ */
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .related-card {
    background: var(--color-white);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--dur-base) var(--ease), box-shadow var(--dur-base) var(--ease);
    color: var(--text-primary);
  }
  .related-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .related-card__media { aspect-ratio: 16/10; overflow: hidden; position: relative; }
  .related-card__media img {
    width: 100%; height: 100%; object-fit: cover;
    object-position: center 65%;
    transition: transform 1s var(--ease-out);
  }
  .related-card:hover .related-card__media img { transform: scale(1.05); }
  .related-card__chip {
    position: absolute;
    bottom: 0.85rem;
    left: 0.85rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .related-card__chip--rent {
    background: rgba(10, 29, 63, 0.92);
    color: var(--color-gold-soft);
  }
  .related-card__chip--sale {
    background: var(--color-gold);
    color: var(--color-navy);
  }
  .related-card__body { padding: 1.25rem; }
  .related-card__meta {
    font-size: 0.7rem;
    color: var(--color-gold);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .related-card__title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    color: var(--color-navy);
    margin: 0.4rem 0 0.75rem;
    line-height: 1.25;
    font-weight: 600;
  }
  .related-card__price {
    font-size: 0.9rem;
    color: var(--color-gold);
    font-weight: 700;
  }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 960px) {
    .prop-gallery-wrap { padding-top: calc(var(--header-height) + 1.5rem); }
    .prop-gallery { grid-template-columns: 1fr; height: auto; }
    .prop-gallery__main { aspect-ratio: 16/10; }
    .prop-gallery__thumbs {
      display: grid;
      grid-template-rows: none;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }
    .prop-gallery__thumb {
      aspect-ratio: 1;
      min-height: 80px;
    }
    .prop-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    .prop-sidebar { position: static; }
    .amenities-grid { grid-template-columns: repeat(2, 1fr); }
    .prop-process { grid-template-columns: 1fr; }
    .related-grid { grid-template-columns: 1fr; }
    .inquiry-form .field-row { grid-template-columns: 1fr; }
  }

  @media (max-width: 540px) {
    body:has(.prop-gallery-wrap) .site-header {
      display: none;
    }
    .prop-gallery-wrap {
      padding-top: 0.75rem;
      padding-bottom: 0;
