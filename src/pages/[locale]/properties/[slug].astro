<script>
  // Description collapse / "View more"
  document.querySelectorAll<HTMLElement>('[data-collapse]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-collapse-toggle]');
    const extra = root.querySelector<HTMLElement>('[data-collapse__extra], .prop-description__extra');
    if (!toggle || !extra) return;
    toggle.hidden = false;
    const labelMore = toggle.querySelector<HTMLElement>('[data-collapse-label-more]');
    const labelLess = toggle.querySelector<HTMLElement>('[data-collapse-label-less]');
    toggle.addEventListener('click', () => {
      const isOpen = !extra.hidden;
      extra.hidden = isOpen;
      if (labelMore) labelMore.hidden = !isOpen;
      if (labelLess) labelLess.hidden = isOpen;
    });
  });

  // ============ Inline datepicker in booking sidebar (rental only) ============
  document.querySelectorAll<HTMLElement>('[data-datepicker]').forEach((root) => {
    const pricePerNight = Number(root.dataset.pricePerNight ?? 0);
    const cleaningFee = Number(root.dataset.cleaningFee ?? 0);
    const minNights = Number(root.dataset.minNights ?? 1);
    const checkInEl = root.querySelector<HTMLInputElement>('#prop-checkin');
    const checkOutEl = root.querySelector<HTMLInputElement>('#prop-checkout');
    const guestsEl = root.querySelector<HTMLSelectElement>('#prop-guests');
    const bookLink = root.querySelector<HTMLAnchorElement>('[data-book-link]');
    const bookLabel = root.querySelector<HTMLElement>('[data-book-label]');
    const ctaText = bookLabel?.textContent ?? '';
    const help = root.querySelector<HTMLElement>('[data-estimate-help]');

    const estimateRows = {
      nights:    root.querySelector<HTMLElement>('[data-estimate-row="nights"]'),
      subtotal:  root.querySelector<HTMLElement>('[data-estimate-row="subtotal"]'),
      cleaning:  root.querySelector<HTMLElement>('[data-estimate-row="cleaning"]'),
      service:   root.querySelector<HTMLElement>('[data-estimate-row="service"]'),
      total:     root.querySelector<HTMLElement>('[data-estimate-row="total"]'),
    };

    const estimateNightsLabel = root.querySelector<HTMLElement>('[data-estimate-nights-label]');
    const estimateNightsValue = root.querySelector<HTMLElement>('[data-estimate-nights-value]');
    const estimateSubtotal    = root.querySelector<HTMLElement>('[data-estimate-subtotal]');
    const estimateCleaning    = root.querySelector<HTMLElement>('[data-estimate-cleaning]');
    const estimateService     = root.querySelector<HTMLElement>('[data-estimate-service]');
    const estimateTotal       = root.querySelector<HTMLElement>('[data-estimate-total]');

    if (!checkInEl || !checkOutEl) return;

    // Set min date = tomorrow
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const minDate = tomorrow.toISOString().split('T')[0];
    checkInEl.min = minDate;
    checkOutEl.min = minDate;

    const compute = () => {
      const checkIn = checkInEl.value;
      const checkOut = checkOutEl.value;
      const guests = parseInt(guestsEl.value, 10);

      const formatCurrency = (n: number) =>
        new Intl.NumberFormat(document.documentElement.lang === 'es' ? 'es-ES' : 'en-GB', {
          style: 'currency', currency: 'EUR', minimumFractionDigits: 0, maximumFractionDigits: 0,
        }).format(n);

      if (!checkIn || !checkOut) {
        // No selection — show help, hide estimate
        Object.values(estimateRows).forEach(el => el && (el.hidden = true));
        if (help) help.hidden = false;
        if (bookLink) {
          bookLink.setAttribute('href', '#book');
          if (bookLabel) bookLabel.textContent = ctaText;
        }
        return;
      }

      const a = new Date(checkIn);
      const b = new Date(checkOut);
      const nights = Math.max(0, Math.round((b.getTime() - a.getTime()) / 86400000));

      if (nights <= 0) {
        Object.values(estimateRows).forEach(el => el && (el.hidden = true));
        if (help) help.hidden = true;
        if (bookLink) {
          bookLink.setAttribute('href', '#book');
          if (bookLabel) bookLabel.textContent = ctaText;
        }
        return;
      }

      const subtotal = nights * pricePerNight;
      const service = Math.round(subtotal * 0.10);
      const total = subtotal + cleaningFee + service;

      // Show rows
      if (estimateNightsLabel) estimateNightsLabel.textContent = `${nights} ${nights === 1 ? 'noche' : 'noches'}`;
      if (estimateNightsValue) estimateNightsValue.textContent = formatCurrency(pricePerNight) + ' × ' + nights;
      if (estimateSubtotal) estimateSubtotal.textContent = formatCurrency(subtotal);
      if (estimateCleaning) estimateCleaning.textContent = formatCurrency(cleaningFee);
      if (estimateService) estimateService.textContent = formatCurrency(service);
      if (estimateTotal) estimateTotal.textContent = formatCurrency(total);
      Object.values(estimateRows).forEach(el => el && (el.hidden = false));
      if (help) help.hidden = true;

      // Update booking link with query params
      if (bookLink) {
        const baseHref = bookLink.getAttribute('href')?.split('?')[0] ?? '#book';
        const u = new URL(baseHref, window.location.origin + window.location.pathname);
        u.searchParams.set('checkIn', checkIn);
        u.searchParams.set('checkOut', checkOut);
        u.searchParams.set('guests', String(guests));
        bookLink.setAttribute('href', u.pathname + u.search);
      }
    };

    [checkInEl, checkOutEl, guestsEl].forEach(el => {
      el.addEventListener('change', () => {
        // Update checkout min
        if (checkInEl.value) {
          const checkIn = new Date(checkInEl.value);
          checkIn.setDate(checkIn.getDate() + 1);
          checkOutEl.min = checkIn.toISOString().split('T')[0];
          // Reset checkout if it's now invalid
          if (checkOutEl.value && new Date(checkOutEl.value) <= new Date(checkInEl.value)) {
            checkOutEl.value = checkIn.toISOString().split('T')[0];
          }
        }
        compute();
      });
    });
    compute();

    // Lightbox trigger via keyboard (Enter/Space)
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const t = e.target as HTMLElement;
      if (t.hasAttribute('data-lightbox-trigger') && document.activeElement === t) {
        e.preventDefault();
        t.click();
      }
    });
  });
</script>

