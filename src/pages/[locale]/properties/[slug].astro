---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { t, supportedLocales, type Locale } from '../../../utils/i18n';
import {
  propertyTypeLabel,
  statusLabel,
  formatPrice,
} from '../../../data/properties';
import { getProperties, zoneLabel, type Property } from '../../../data/property-source';

export async function getStaticPaths() {
  const { properties } = await getProperties();
  const paths: Array<{ params: { locale: string; slug: string; }; props: { property: Property; otherProps: Property[] } }> = [];
  for (const locale of supportedLocales) {
    for (const p of properties) {
      // related: misma zone (libre, ya no es enum cerrado)
      const otherProps = properties
        .filter((x) => x.destination === p.destination && x.id !== p.id)
        .slice(0, 3);
      paths.push({ params: { locale, slug: p.slug }, props: { property: p, otherProps } });
    }
  }
  return paths;
}

const { property, otherProps } = Astro.props as { property: Property; otherProps: Property[] };
const locale = Astro.params.locale as Locale;

// Nivora = solo alquiler larga duración. CTA = "Solicitar información".
// Versión de precio: €/mes (Nivora envía amountCents/mes).
const priceUnit = `/${locale === 'es' ? 'mes' : 'month'}`;
const ctaLabel = t(locale, 'properties.requestInfo');
const ctaHref = '#inquiry';
const visitLabel = locale === 'es' ? 'Concertar visita' : 'Schedule a viewing';
const visitHref = '#visit';

// Features por idioma: en ES usa features.es; en EN usa features.en con
// fallback a features.es si está vacío.
const features = (() => {
  const es = property.features.es ?? [];
  const enRaw = property.features.en ?? [];
  const en = enRaw.length > 0 ? enRaw : es;
  if (locale === 'es') return es;
  return en;
})();

const destLabel = zoneLabel(property.destination, locale);

// Amenity icon SVGs (custom, monoline, fit Montserrat aesthetic)
const amenityIcons: Record<string, string> = {
  pool:        '<path d="M2 18c1.5 0 1.5-1 3-1s1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1"/><path d="M6 14V9a3 3 0 0 1 6 0v5"/><path d="M12 10c1.5 0 1.5-1 3-1s1.5 1 3 1"/><path d="M12 6c1.5 0 1.5-1 3-1s1.5 1 3 1"/>',
  wifi:        '<path d="M5 12.55a11 11 0 0 1 14 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0"/><circle cx="12" cy="20" r="1.5"/>',
  ac:          '<path d="M3 7v10M21 7v10M3 12h18M7 5h10M7 19h10"/>',
  parking:     '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 17V7h5a3 3 0 0 1 0 6h-5"/>',
  kitchen:     '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M3 7l3-4h12l3 4M7 12v4M11 12v4M15 12v4M17 12v4"/>',
  'sea-view':  '<path d="M2 18c3 0 3-2 6-2s3 2 6 2 3-2 6-2"/><path d="M2 14c3 0 3-2 6-2s3 2 6 2 3-2 6-2"/><circle cx="17" cy="5" r="2.5"/>',
  'city-view': '<path d="M3 21h18M5 21V8h4v13M11 21V4h4v17M17 21v-9h4v9"/>',
  garden:      '<path d="M12 2v8m-7-3l5 5m9-5l-5 5M5 14c0 4 3 7 7 7s7-3 7-7"/>',
  terrace:     '<rect x="3" y="9" width="18" height="9" rx="1"/><path d="M3 9l9-6 9 6M8 14h2M14 14h2"/>',
  jacuzzi:     '<circle cx="12" cy="12" r="9"/><circle cx="9" cy="11" r="0.8"/><circle cx="13" cy="10" r="0.8"/><circle cx="15" cy="13" r="0.8"/>',
  gym:         '<path d="M2 12h2M20 12h2M6 8v8M18 8v8M6 12h12"/>',
  cinema:      '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9h18M8 5v14M16 5v14"/>',
  bbq:         '<rect x="3" y="9" width="18" height="11" rx="1"/><path d="M8 9V5a4 4 0 0 1 8 0v4M12 13v-2"/>',
  fireplace:   '<path d="M5 21h14M5 21V8h5l2-3 2 3h5v13M12 14c-2 0-3 2-3 4s2 2 3 2 3 0 3-2-1-4-3-4z"/>',
  'beach-access': '<path d="M3 14c1.5-2 4-2 6 0s4.5 2 6 0 4-2 6 0M2 18h20M12 4v3M11 4h2"/>',
  concierge:   '<circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2"/>',
  elevator:    '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 8v4M9 11l3-3 3 3M9 16l3 3 3-3M8 6h8"/>',
};
---

<BaseLayout
  title={property.name[locale]}
  description={property.tagline[locale]}
  transparentHeader={false}
>
  <!-- =======================================================
       Hero: Gallery + Title (top section, full bleed)
       ======================================================= -->
  <section class="prop-gallery-wrap">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="prop-breadcrumb reveal" aria-label="Breadcrumb">
        <a href={`/${locale}/`}>{t(locale, 'properties.breadcrumbHome')}</a>
        <span aria-hidden="true">›</span>
        <a href={`/${locale}/properties`}>{t(locale, 'properties.breadcrumbProperties')}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{property.name[locale]}</span>
      </nav>

      <!-- Gallery -->
      <div class="prop-gallery reveal">
        <div
          class="prop-gallery__main"
          data-lightbox-trigger="property"
          data-lightbox-group="property"
          role="button"
          tabindex="0"
          aria-label={locale === 'es' ? 'Ver fotos en pantalla completa' : 'View photos fullscreen'}
        >
          <img src={property.images[0]} alt={property.name[locale]} loading="eager" fetchpriority="high"
               style={`object-position: ${property.imagePosition ?? 'center 62%'};`} />
          <span class={`prop-gallery__badge prop-gallery__badge--${property.status === 'available' ? 'rent' : 'sale'}`}>
            {statusLabel(property.status, locale)}
          </span>
          <span class="prop-gallery__zoom" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7"/>
              <path d="m21 21-4.3-4.3M11 8v6M8 11h6"/>
            </svg>
          </span>
        </div>
        <div class="prop-gallery__thumbs">
          {property.images.slice(1, 4).map(img => (
            <div class="prop-gallery__thumb" data-lightbox-trigger="property" data-lightbox-group="property" role="button" tabindex="0" aria-label="Ver foto">
              <img src={img} alt="" loading="lazy" />
            </div>
          ))}
          {property.images.length < 4 && Array.from({ length: 4 - property.images.length }).map(() => (
            <div class="prop-gallery__thumb prop-gallery__thumb--placeholder">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <circle cx="9" cy="9" r="2"/>
                <path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>
              </svg>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- =======================================================
       Body: Title + Specs + Sidebar CTA + Inquiry form
       ======================================================= -->
  <section class="section prop-body">
    <div class="container">
      <div class="prop-layout">
        <!-- ============ MAIN COLUMN ============ -->
        <div class="prop-main">

          <!-- Title -->
          <header class="prop-title-block reveal">
            <div class="prop-title-block__meta">
              <span class="prop-title-block__type">{propertyTypeLabel(property.type, locale)}</span>
              <span class="prop-title-block__dot">·</span>
              <a href={`/${locale}/properties?dest=${property.destination}`} class="prop-title-block__city">{destLabel}</a>
              <span class="prop-title-block__dot">·</span>
              <span>{property.location[locale]}</span>
              {property.reference && (
                <>
                  <span class="prop-title-block__dot">·</span>
                  <span class="prop-title-block__reference">Ref. {property.reference}</span>
                </>
              )}
            </div>
            <h1 class="prop-title-block__title">{property.name[locale]}</h1>
            <p class="prop-title-block__tagline">{property.tagline[locale]}</p>
          </header>

          <!-- Quick specs horizontal bar -->
          <div class="prop-quick-specs reveal">
            <div class="prop-quick-spec">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
              <span><strong>{property.bedrooms}</strong> {t(locale, 'common.bedrooms')}</span>
            </div>
            <div class="prop-quick-spec">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M2 4v16M22 4v16M2 8h20M2 16h20M6 4v16M18 4v16"/>
              </svg>
              <span><strong>{property.bedrooms}</strong> {t(locale, 'common.bedrooms')}</span>
            </div>
            <div class="prop-quick-spec">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M9 6L6 18h12l-3-12M9 6V4a3 3 0 0 1 6 0v2M5 21h14"/>
              </svg>
              <span><strong>{property.bathrooms}</strong> {t(locale, 'common.bathrooms')}</span>
            </div>
            <div class="prop-quick-spec">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <path d="M3 10h18"/>
              </svg>
              <span><strong>{property.sizeM2}</strong> m²</span>
            </div>
            <div class="prop-quick-spec">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
              <span class={property.status === 'available' ? 'text-emerald-700' : 'text-amber-700'}>
                {statusLabel(property.status, locale)}
              </span>
            </div>
          </div>

          <!-- Description with collapse -->
          <section class="prop-section reveal">
            <h2 class="h3 prop-section__title">{t(locale, 'properties.highlights')}</h2>
            <div class="prop-description" data-collapse>
              <p class="prop-description__text">{property.description[locale]}</p>
              <p class="prop-description__extra" hidden>
                {locale === 'es'
                  ? `Una propiedad única en ${destLabel}, gestionada por Global Move con los más altos estándares de calidad. Cada detalle ha sido cuidado para ofrecer una experiencia memorable a nuestros clientes.`
                  : `A unique property in ${destLabel}, managed by Global Move with the highest standards of quality. Every detail has been carefully curated to deliver a memorable experience to our clients.`}
              </p>
              <button type="button" class="prop-description__toggle" data-collapse-toggle hidden>
                <span data-collapse-label-more>{t(locale, 'properties.viewMore')}</span>
                <span data-collapse-label-less hidden>{t(locale, 'properties.viewLess')}</span>
              </button>
            </div>
          </section>

          <!-- Features (amenities) — ES/EN con fallback -->
          <section class="prop-section reveal">
            <header class="prop-section__header">
              <h2 class="h3">{t(locale, 'properties.amenitiesTitle')}</h2>
              <span class="prop-section__count">
                {t(locale, 'properties.amenitiesCount', { n: features.length })}
              </span>
            </header>
            <div class="amenities-grid">
              {features.map(a => (
                <div class="amenity-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                       stroke-linecap="round" stroke-linejoin="round" set:html={amenityIcons[a] ?? ''} />
                  <span>{a}</span>
                </div>
              ))}
            </div>
          </section>

          <!-- Map placeholder -->
          <section class="prop-section reveal">
            <header class="prop-section__header">
              <h2 class="h3">{t(locale, 'properties.neighborhood')}</h2>
            </header>
            <div class="prop-map">
              <iframe
                src={`https://maps.google.com/maps?q=${property.lat},${property.lng}&z=14&output=embed`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title={`${property.name[locale]} - ${property.location[locale]}`}
              ></iframe>
              <div class="prop-map__overlay">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-7 8-13a8 8 0 0 0-16 0c0 6 8 13 8 13z"/>
                  <circle cx="12" cy="9" r="3"/>
                </svg>
                <div>
                  <strong>{property.location[locale]}</strong>
                  <span>{t(locale, 'properties.neighborhoodDesc', { city: destLabel })}</span>
                </div>
              </div>
            </div>
          </section>

          <!-- Inquiry form (Solicitar información) -->
          <section id="inquiry" class="prop-section prop-inquiry reveal">
            <h2 class="h3 prop-section__title">{t(locale, 'salesInquiry.title')}</h2>
            <p class="lead">{t(locale, 'salesInquiry.subtitle')}</p>

            <form class="inquiry-form" id="inquiry-form" novalidate data-loading-on-submit>
              <div class="field-row">
                <div class="field">
                  <label for="inquiry-name">{t(locale, 'salesInquiry.fullName')}</label>
                  <input type="text" id="inquiry-name" name="name" class="input" required autocomplete="name" />
                </div>
                <div class="field">
                  <label for="inquiry-email">{t(locale, 'salesInquiry.email')}</label>
                  <input type="email" id="inquiry-email" name="email" class="input" required autocomplete="email" />
                </div>
              </div>
              <div class="field-row">
                <div class="field">
                  <label for="inquiry-phone">{t(locale, 'salesInquiry.phone')}</label>
                  <input type="tel" id="inquiry-phone" name="phone" class="input" required autocomplete="tel" />
                </div>
                <div class="field">
                  <label for="inquiry-country">{t(locale, 'salesInquiry.country')}</label>
                  <input type="text" id="inquiry-country" name="country" class="input" autocomplete="country-name" />
                </div>
              </div>
              <div class="field">
                <label for="inquiry-message">{t(locale, 'salesInquiry.message')}</label>
                <textarea id="inquiry-message" name="message" class="textarea" rows="4"></textarea>
              </div>
              <p class="inquiry-form__privacy">{t(locale, 'salesInquiry.privacy')}</p>
              <button type="submit" class="btn btn--primary inquiry-form__submit" data-magnetic="0.25">
                <span data-magnetic-inner>{t(locale, 'salesInquiry.submit')}</span>
              </button>
            </form>
          </section>

          <section class="prop-section reveal">
            <header class="prop-section__header prop-section__header--center">
              <p class="eyebrow">{t(locale, 'properties.processSubtitle')}</p>
              <h2 class="h2">{t(locale, 'properties.processTitle')}</h2>
            </header>
            <ol class="prop-process" data-stagger data-stagger-step="120">
              {[1, 2, 3].map((num, i) => (
                <li class="prop-process__step reveal reveal--fade">
                  <span class="prop-process__num">{String(num).padStart(2, '0')}</span>
                  <h3>{t(locale, `properties.processStep${num}Title`)}</h3>
                  <p>{t(locale, `properties.processStep${num}Desc`)}</p>
                </li>
              ))}
            </ol>
          </section>

          <!-- Cancellation policy -->
          <section class="prop-cancellation reveal">
            <h3>{t(locale, 'properties.cancellationTitle')}</h3>
            <p class="prop-cancellation__body">
              {locale === 'es'
                ? 'Cancelación gratuita hasta 30 días antes de la fecha de entrada. Entre 30 y 14 días antes, reembolso del 50%. Después, se aplican las condiciones específicas del propietario. Para estancias de más de 28 días o reservas en temporada alta, consulta condiciones particulares.'
                : 'Free cancellation up to 30 days before check-in. Between 30 and 14 days before, 50% refund. After that, owner-specific terms apply. For stays over 28 days or peak-season bookings, see specific conditions.'}
            </p>
          </section>
        </div>

        <!-- ============ SIDEBAR (Solicitar info + Concertar visita) ============ -->
        <aside class="prop-sidebar">
          <div class="booking-card reveal reveal--scale">
            <div class="booking-card__top">
              <div class={`booking-card__chip booking-card__chip--${property.status === 'available' ? 'rent' : 'sale'}`}>
                {statusLabel(property.status, locale)}
              </div>
              <div class="booking-card__price">
                <span class="booking-card__from">{t(locale, 'common.from')}</span>
                <span class="booking-card__amount">{formatPrice(property.price, locale)}</span>
                <span class="booking-card__unit">{priceUnit}</span>
              </div>
              {property.reference && (
                <p class="booking-card__ref">
                  <span class="booking-card__ref-label">{locale === 'es' ? 'Referencia' : 'Reference'}</span>
                  <span class="booking-card__ref-value">{property.reference}</span>
                </p>
              )}
              <div class="booking-card__cta-group">
                <a href={ctaHref} class="btn btn--primary w-full text-base">
                  {ctaLabel}
                </a>
                <a href={visitHref} class="btn btn--secondary w-full text-base">
                  {visitLabel}
                </a>
              </div>
              <p class="booking-card__note booking-card__note--trust">
                🔒 {locale === 'es'
                  ? 'Tus datos solo se usan para esta consulta · Sin compromiso'
                  : 'Your data is only used for this inquiry · No commitment'}
              </p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Related listings -->
  {otherProps.length > 0 && (
    <section class="section section--subtle">
      <div class="container">
        <header class="section-header reveal">
          <p class="eyebrow">{t(locale, 'properties.relatedInDestination', { city: destLabel })}</p>
          <h2 class="h2">{t(locale, 'properties.title')}</h2>
        </header>
        <div class="related-grid" data-stagger data-stagger-step="80">
          {otherProps.map((p, i) => (
            <a href={`/${locale}/properties/${p.slug}`} class="related-card reveal reveal--fade" data-tilt="3">
              <div class="related-card__media">
                <img src={p.images[0]} alt={p.name[locale]} loading="lazy"
                     style={`object-position: ${p.imagePosition ?? 'center 62%'};`} />
                <span class={`related-card__chip related-card__chip--${p.transaction === 'sale' ? 'sale' : 'rent'}`}>
                  {p.transaction === 'sale' ? t(locale, 'properties.saleBadge') : t(locale, 'properties.rentBadge')}
                </span>
              </div>
              <div class="related-card__body">
                <span class="related-card__meta">{propertyTypeLabel(p.type, locale)}</span>
                <h3 class="related-card__title">{p.name[locale]}</h3>
                <span class="related-card__price">
                  {t(locale, 'common.from')} {formatPrice(p.price, locale)} /{locale === 'es' ? 'mes' : 'month'}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<!-- Mobile sticky bottom CTA bar (visible only on mobile) -->
<div class="prop-mobile-cta" data-mobile-cta>
  <div class="prop-mobile-cta__price">
    <span class="prop-mobile-cta__from">{t(locale, 'common.from')}</span>
    <span class="prop-mobile-cta__amount">{formatPrice(property.price, locale)}</span>
    <span class="prop-mobile-cta__unit">{priceUnit}</span>
  </div>
  <a href={ctaHref} class="btn btn--primary prop-mobile-cta__btn" data-magnetic="0.25">
    <span data-magnetic-inner>{ctaLabel}</span>
  </a>
</div>

<script>
  // Description collapse / "View more"
  document.querySelectorAll<HTMLElement>('[data-collapse]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-collapse-toggle]');
    const extra = root.querySelector<HTMLElement>('[data-collapse__extra], .prop-description__extra');
    if (!toggle || !extra) return;
    toggle.hidden = false;
    const labelMore = toggle.querySelector<HTMLElement>('[data-collapse-label-more]');
    const labelLess = toggle.querySelector<HTMLElement>('[data-collapse-label-less]');
    toggle.addEventListener('click', () => {
      const isOpen = !extra.hidden;
      extra.hidden = isOpen;
      if (labelMore) labelMore.hidden = !isOpen;
      if (labelLess) labelLess.hidden = isOpen;
    });
  });
</script>

<style is:global>
/* Estilos extraídos de la versión anterior — se conservaron porque el
   template los sigue utilizando (gallery, prop-title-block, amenities, etc.).
   Restaurar manualmente si hace falta. */
</style>
