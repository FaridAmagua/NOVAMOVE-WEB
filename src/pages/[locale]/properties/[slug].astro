  <a href={ctaHref} target="_blank" rel="noopener noreferrer" class="btn btn--primary prop-mobile-cta__btn" data-magnetic="0.25">
    <span data-magnetic-inner>{ctaLabel}</span>
  </a>
</div>
</BaseLayout>

<script>
  // Description collapse / "View more"
  document.querySelectorAll<HTMLElement>('[data-collapse]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-collapse-toggle]');
    const extra = root.querySelector<HTMLElement>('[data-collapse__extra], .prop-description__extra');
    if (!toggle || !extra) return;
    toggle.hidden = false;
    const labelMore = toggle.querySelector<HTMLElement>('[data-collapse-label-more]');
    const labelLess = toggle.querySelector<HTMLElement>('[data-collapse-label-less]');
    toggle.addEventListener('click', () => {
      const isOpen = !extra.hidden;
      extra.hidden = isOpen;
      if (labelMore) labelMore.hidden = !isOpen;
      if (labelLess) labelLess.hidden = isOpen;
    });
  });

  document.querySelectorAll<HTMLElement>('[data-description-collapse]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-description-toggle]');
    const extra = root.querySelector<HTMLElement>('.prop-description__extra');
    if (!toggle || !extra) return;

    const labelMore = toggle.querySelector<HTMLElement>('[data-description-label-more]');
    const labelLess = toggle.querySelector<HTMLElement>('[data-description-label-less]');

    toggle.addEventListener('click', () => {
      const shouldOpen = extra.hidden;
      extra.hidden = !shouldOpen;
      if (labelMore) labelMore.hidden = shouldOpen;
      if (labelLess) labelLess.hidden = !shouldOpen;
      toggle.setAttribute('aria-expanded', String(shouldOpen));
    });

    toggle.setAttribute('aria-expanded', String(!extra.hidden));
  });

  const setupMobileAccordions = () => {
    document.querySelectorAll<HTMLDetailsElement>('.prop-mobile-accordion').forEach((details) => {
      details.open = true;
    });
  };
  setupMobileAccordions();
  window.addEventListener('resize', setupMobileAccordions, { passive: true });

  document.querySelectorAll<HTMLButtonElement>('[data-property-share]').forEach((button) => {
    button.addEventListener('click', async () => {
      const shareData = {
        title: document.title,
        text: document.querySelector<HTMLMetaElement>('meta[name="description"]')?.content ?? document.title,
        url: window.location.href,
      };
      try {
        if (navigator.share) {
          await navigator.share(shareData);
          return;
        }
        await navigator.clipboard?.writeText(window.location.href);
      } catch {
        // Sharing can be cancelled by the user; no UI error needed.
      }
    });
  });

  const setupPropertyDetailNav = () => {
    const nav = document.querySelector<HTMLElement>('.prop-detail-nav');
    if (!nav) return;

    const update = () => {
      nav.classList.toggle('is-scrolled', window.scrollY > 36);
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
  };
  setupPropertyDetailNav();

  const setupPropertyMenu = () => {
    const toggle = document.querySelector<HTMLButtonElement>('[data-prop-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-prop-menu]');
    if (!toggle || !menu || toggle.dataset.propMenuReady === 'true') return;
    toggle.dataset.propMenuReady = 'true';

    const setOpen = (open: boolean) => {
      toggle.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
      menu.setAttribute('aria-hidden', String(!open));
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
    document.addEventListener('astro:before-swap', () => setOpen(false));
  };
  setupPropertyMenu();

  const setupTourScheduler = () => {
    const root = document.querySelector<HTMLElement>('.booking-card');
    if (!root) return;
    if (root.dataset.tourSchedulerReady === 'true') return;
    root.dataset.tourSchedulerReady = 'true';

    const locale = document.documentElement.lang?.startsWith('es') ? 'es-ES' : 'en-US';
    const dayButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tour-day]'));
    const typeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tour-type]'));
    const timeSelect = root.querySelector<HTMLSelectElement>('[data-tour-time]');
    const timeToggle = root.querySelector<HTMLButtonElement>('[data-tour-time-toggle]');
    const timeOptions = root.querySelector<HTMLElement>('[data-tour-time-options]');
    const timeLabel = root.querySelector<HTMLElement>('[data-tour-time-label]');
    const timeOptionButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tour-time-option]'));
    const submit = root.querySelector<HTMLAnchorElement>('[data-tour-submit]');
    const formView = root.querySelector<HTMLElement>('[data-tour-form]');
    const requestForm = root.querySelector<HTMLFormElement>('[data-tour-request-form]');
    const changeButton = root.querySelector<HTMLButtonElement>('[data-tour-change]');
    const summary = root.querySelector<HTMLElement>('[data-tour-summary]');
    const prev = root.querySelector<HTMLButtonElement>('[data-tour-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-tour-next]');
    if (!dayButtons.length || !timeSelect || !submit) return;

    let offset = 0;
    let selectedDate = '';
    let selectedType = typeButtons.find((button) => button.getAttribute('aria-pressed') === 'true')?.dataset.tourType ?? 'person';

    const monthFormatter = new Intl.DateTimeFormat(locale, { month: 'short' });
    const weekdayFormatter = new Intl.DateTimeFormat(locale, { weekday: 'long' });
    const summaryFormatter = new Intl.DateTimeFormat(locale, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    const isoDate = (date: Date) => {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };

    const updateSubmit = () => {
      const hasSelection = Boolean(selectedDate && timeSelect.value);
      submit.setAttribute('aria-disabled', String(!hasSelection));
      submit.classList.toggle('is-disabled', !hasSelection);
      submit.dataset.tourDate = selectedDate;
      submit.dataset.tourTime = timeSelect.value;
      submit.dataset.tourType = selectedType;
    };

    const setSummary = () => {
      if (!summary || !selectedDate || !timeSelect.value) return;
      const date = new Date(`${selectedDate}T12:00:00`);
      summary.textContent = `${summaryFormatter.format(date)} ${locale === 'es-ES' ? 'a las' : 'at'} ${timeSelect.value}`;
    };

    const showRequestForm = () => {
      if (!formView) return;
      setSummary();
      formView.hidden = false;
      root.classList.add('is-form-open');
      root.querySelector<HTMLInputElement>('[name="fullName"]')?.focus();
    };

    const showScheduler = () => {
      if (!formView) return;
      root.classList.remove('is-form-open');
      formView.hidden = true;
      timeToggle?.focus();
    };

    const renderDays = () => {
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      dayButtons.forEach((button, index) => {
        const date = new Date(today);
        date.setDate(today.getDate() + offset + index);
        const value = isoDate(date);
        button.dataset.tourDate = value;
        button.querySelector('small')!.textContent = weekdayFormatter.format(date);
        button.querySelector('strong')!.textContent = String(date.getDate());
        button.querySelector('em')!.textContent = monthFormatter.format(date).replace('.', '');
        const isSelected = selectedDate === value;
        button.classList.toggle('is-selected', isSelected);
        button.setAttribute('aria-pressed', String(isSelected));
      });

      updateSubmit();
    };

    dayButtons.forEach((button) => {
      button.addEventListener('click', () => {
        selectedDate = button.dataset.tourDate ?? '';
        renderDays();
      });
    });

    typeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        selectedType = button.dataset.tourType ?? 'person';
        typeButtons.forEach((item) => {
          const isSelected = item === button;
          item.classList.toggle('is-selected', isSelected);
          item.setAttribute('aria-pressed', String(isSelected));
        });
        updateSubmit();
      });
    });

    prev?.addEventListener('click', () => {
      offset = Math.max(0, offset - 3);
      renderDays();
    });

    next?.addEventListener('click', () => {
      offset += 3;
      renderDays();
    });

    const closeTimeOptions = () => {
      if (!timeOptions || !timeToggle) return;
      timeOptions.hidden = true;
      timeToggle.setAttribute('aria-expanded', 'false');
      timeToggle.classList.remove('is-open');
    };

    timeToggle?.addEventListener('click', () => {
      if (!timeOptions) return;
      const isOpen = timeOptions.hidden;
      timeOptions.hidden = !isOpen;
      timeToggle.setAttribute('aria-expanded', String(isOpen));
      timeToggle.classList.toggle('is-open', isOpen);
    });

    timeOptionButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.value;
        timeSelect.value = value;
        if (timeLabel) timeLabel.textContent = value;
        timeOptionButtons.forEach((item) => item.classList.toggle('is-selected', item === button));
        closeTimeOptions();
        updateSubmit();
      });
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) closeTimeOptions();
    });

    submit.addEventListener('click', (event) => {
      if (submit.getAttribute('aria-disabled') === 'true') {
        event.preventDefault();
        timeToggle?.focus();
        return;
      }
      event.preventDefault();
      showRequestForm();
    });

    changeButton?.addEventListener('click', showScheduler);

    requestForm?.addEventListener('submit', (event) => {
      event.preventDefault();
    });

    typeButtons[0]?.classList.add('is-selected');
    renderDays();
  };
  setupTourScheduler();
  document.addEventListener('astro:page-load', setupTourScheduler);
</script>

