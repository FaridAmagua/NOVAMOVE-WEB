---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { t, localeParams, type Locale } from '../../../utils/i18n';

const locale = Astro.params.locale as Locale;
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => p.data.locale === locale)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const formatDate = (d: Date, loc: Locale) =>
  d.toLocaleDateString(loc === 'es' ? 'es-ES' : 'en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

const categoryLabel = (cat: string, loc: Locale) => t(loc, `blog.categories.${cat}`);
export async function getStaticPaths() {
  return localeParams;
}
---

<BaseLayout
  title={t(locale, 'blog.title')}
  description={t(locale, 'blog.subtitle')}
  transparentHeader={true}
>
  <PageHero
    eyebrow={t(locale, 'blog.title')}
    title={locale === 'es' ? 'Blog &<br/><span class="italic-serif">News.</span>' : 'Blog &<br/><span class="italic-serif">News.</span>'}
    subtitle={t(locale, 'blog.subtitle')}
    image="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=2000&q=80"
    align="center"
  />

  <section class="section">
    <div class="container">
      {posts.length === 0 ? (
        <p class="text-center text-text-secondary py-16 text-lg">
          {locale === 'es' ? 'Próximamente publicaremos artículos.' : 'Articles coming soon.'}
        </p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post, i) => (
            <article
              class="reveal bg-white border border-navy/5 rounded-lg overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl"
              style={`transition-delay:${i * 60}ms`}
            >
              <a
                href={`/${locale}/blog/${post.slug.replace(/\.(es|en)$/, '')}`}
                class="block text-text-primary no-underline"
              >
                {post.data.cover && (
                  <div class="aspect-[16/10] overflow-hidden">
                    <img
                      src={post.data.cover}
                      alt={post.data.coverAlt ?? ''}
                      loading="lazy"
                      class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                    />
                  </div>
                )}
                <div class="p-7">
                  <span class="inline-block text-xs font-semibold tracking-[0.18em] uppercase text-gold mb-3.5">
                    {categoryLabel(post.data.category, locale)}
                  </span>
                  <h2 class="font-serif text-2xl leading-tight text-navy mb-3.5 transition-colors duration-300 group-hover:text-gold">
                    {post.data.title}
                  </h2>
                  <p class="text-[0.92rem] leading-relaxed text-text-secondary mb-5 line-clamp-3">
                    {post.data.description}
                  </p>
                  <div class="flex gap-2 text-[0.78rem] text-text-secondary pt-4 border-t border-navy/5">
                    <span>{formatDate(post.data.publishDate, locale)}</span>
                    {post.data.readTime && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span>{post.data.readTime} {t(locale, 'blog.minutesRead')}</span>
                      </>
                    )}
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
