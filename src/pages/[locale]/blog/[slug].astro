---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { t, supportedLocales, type Locale } from '../../../utils/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const paths: Array<{ params: { locale: string; slug: string }; props: { post: CollectionEntry<'blog'>; locale: Locale } }> = [];

  for (const locale of supportedLocales) {
    for (const post of posts) {
      if (post.data.locale !== locale) continue;
      // Strip the -es / -en suffix added for uniqueness
      const slug = post.slug.replace(/-(es|en)$/, '');
      paths.push({ params: { locale, slug }, props: { post, locale } });
    }
  }
  return paths;
}

export const prerender = true;

const { post, locale: postLocale } = Astro.props as {
  post: CollectionEntry<'blog'>;
  locale: Locale;
};

const locale = Astro.params.locale as Locale;
const displayLocale = locale ?? postLocale;

const { Content } = await post.render();

const formatDate = (d: Date, loc: Locale) =>
  d.toLocaleDateString(loc === 'es' ? 'es-ES' : 'en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

const allPosts = await getCollection('blog');
const related = allPosts
  .filter(p => p.data.locale === displayLocale && p.slug !== post.slug)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const categoryLabel = (cat: string, loc: Locale) => t(loc, `blog.categories.${cat}`);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  transparentHeader={true}
>
  <article class="article">
    {post.data.cover && (
      <header class="article__hero">
        <img src={post.data.cover} alt={post.data.coverAlt ?? ''} />
        <div class="article__hero-overlay"></div>
        <div class="container article__hero-content">
          <a href={`/${displayLocale}/blog`} class="article__back">← {t(displayLocale, 'blog.backToBlog')}</a>
          <span class="article__cat">{categoryLabel(post.data.category, displayLocale)}</span>
          <h1 class="article__title">{post.data.title}</h1>
          <div class="article__meta">
            <span>{t(displayLocale, 'blog.publishedOn')} {formatDate(post.data.publishDate, displayLocale)}</span>
            {post.data.readTime && (
              <>
                <span aria-hidden="true">·</span>
                <span>{post.data.readTime} {t(displayLocale, 'blog.minutesRead')}</span>
              </>
            )}
            <span aria-hidden="true">·</span>
            <span>{t(displayLocale, 'blog.by')} {post.data.author}</span>
          </div>
        </div>
      </header>
    )}

    <div class="article__body container">
      <div class="article__content">
        <Content />
      </div>
    </div>

    {related.length > 0 && (
      <section class="section section--subtle">
        <div class="container">
          <h2 class="h-3 article__related-heading">{t(displayLocale, 'blog.title')}</h2>
          <div class="related-grid">
            {related.map((p, i) => (
              <a href={`/${displayLocale}/blog/${p.slug.replace(/-(es|en)$/, '')}`} class="related-card reveal" style={`transition-delay:${i * 60}ms`}>
                {p.data.cover && (
                  <div class="related-card__media">
                    <img src={p.data.cover} alt="" loading="lazy" />
                  </div>
                )}
                <div class="related-card__body">
                  <span class="related-card__cat">{categoryLabel(p.data.category, displayLocale)}</span>
                  <h3 class="related-card__title">{p.data.title}</h3>
                  <span class="related-card__cta">{t(displayLocale, 'blog.readMore')} →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style is:global>
  .article__content {
    max-width: 720px;
    margin-inline: auto;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-primary);
  }
  .article__content h2 {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    color: var(--color-navy);
    margin-top: 3rem;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .article__content h3 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--color-navy);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .article__content p { margin-bottom: 1.25rem; }
  .article__content ul, .article__content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .article__content ul li { list-style: disc; margin-bottom: 0.5rem; }
  .article__content ol li { list-style: decimal; margin-bottom: 0.5rem; }
  .article__content a {
    color: var(--color-gold);
    border-bottom: 1px solid currentColor;
    transition: opacity var(--dur-base) var(--ease);
  }
  .article__content a:hover { opacity: 0.7; }
  .article__content blockquote {
    border-left: 3px solid var(--color-gold);
    padding: 0.25rem 0 0.25rem 1.5rem;
    margin: 2rem 0;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-navy);
    font-size: 1.15rem;
  }
  .article__content table {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .article__content th, .article__content td {
    text-align: left;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(10, 29, 63, 0.08);
  }
  .article__content th {
    background: var(--color-light);
    font-weight: 600;
    color: var(--color-navy);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }
  .article__content code {
    background: var(--color-light);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
    color: var(--color-navy);
  }
  .article__content strong { color: var(--color-navy); font-weight: 600; }
</style>

<style>
  .article__hero {
    position: relative;
    color: var(--color-white);
    min-height: 60vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .article__hero img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .article__hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(10,29,63,0.5) 0%, rgba(10,29,63,0.85) 100%);
  }
  .article__hero-content {
    position: relative;
    padding-block: calc(var(--header-height) + 4rem) 4rem;
  }
  .article__back {
    display: inline-block;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-soft);
    margin-bottom: 1.5rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition: gap var(--dur-base) var(--ease);
  }
  .article__back:hover { color: var(--color-white); }
  .article__cat {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    background: rgba(255,255,255,0.08);
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }
  .article__title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.75rem);
    line-height: 1.1;
    color: var(--color-white);
    font-weight: 500;
    margin-bottom: 1.25rem;
    max-width: 880px;
    letter-spacing: -0.015em;
  }
  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: rgba(255,255,255,0.78);
  }
  .article__meta span[aria-hidden] { color: var(--color-gold); }

  .article__body { padding-block: 4rem 5rem; }

  .article__related-heading {
    margin-bottom: 2rem;
    color: var(--color-navy);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .related-card {
    background: var(--color-white);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--dur-base) var(--ease), box-shadow var(--dur-base) var(--ease);
    color: var(--text-primary);
  }
  .related-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .related-card__media { aspect-ratio: 16/10; overflow: hidden; }
  .related-card__media img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 1s var(--ease-out);
  }
  .related-card:hover .related-card__media img { transform: scale(1.05); }
  .related-card__body { padding: 1.5rem; }
  .related-card__cat {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .related-card__title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-navy);
    margin: 0.5rem 0 1rem;
    line-height: 1.25;
  }
  .related-card__cta {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    font-weight: 600;
  }

  @media (max-width: 960px) { .related-grid { grid-template-columns: 1fr; } }
</style>