---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { t, supportedLocales, type Locale } from '../../../utils/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const paths: Array<{ params: { locale: string; slug: string }; props: { post: CollectionEntry<'blog'>; locale: Locale } }> = [];

  for (const locale of supportedLocales) {
    for (const post of posts) {
      if (post.data.locale !== locale) continue;
      const slug = post.slug.replace(/-(es|en)$/, '');
      paths.push({ params: { locale, slug }, props: { post, locale } });
    }
  }
  return paths;
}

export const prerender = true;

const { post, locale: postLocale } = Astro.props as {
  post: CollectionEntry<'blog'>;
  locale: Locale;
};

const locale = Astro.params.locale as Locale;
const displayLocale = locale ?? postLocale;

const { Content } = await post.render();

const formatDate = (d: Date, loc: Locale) =>
  d.toLocaleDateString(loc === 'es' ? 'es-ES' : 'en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

const allPosts = await getCollection('blog');
const related = allPosts
  .filter(p => p.data.locale === displayLocale && p.slug !== post.slug)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const categoryLabel = (cat: string, loc: Locale) => t(loc, `blog.categories.${cat}`);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  transparentHeader={true}
>
  <article class="article">
    {post.data.cover && (
      <header class="relative text-white min-h-[60vh] flex items-end overflow-hidden">
        <img
          src={post.data.cover}
          alt={post.data.coverAlt ?? ''}
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0"
          style="background: linear-gradient(180deg, rgba(10,29,63,0.5) 0%, rgba(10,29,63,0.85) 100%);"
        ></div>
        <div class="container relative pt-[calc(var(--header-height)+4rem)] pb-16">
          <a
            href={`/${displayLocale}/blog`}
            class="inline-block text-xs tracking-[0.14em] uppercase text-gold-soft mb-6 border-b border-current pb-0.5 hover:text-white transition-colors duration-300"
          >← {t(displayLocale, 'blog.backToBlog')}</a>

          <span class="inline-block text-[0.72rem] font-semibold tracking-[0.18em] uppercase text-gold bg-white/10 px-3.5 py-1.5 rounded-full mb-5">
            {categoryLabel(post.data.category, displayLocale)}
          </span>

          <h1 class="font-serif text-white font-medium max-w-5xl leading-tight tracking-tight mb-5"
              style="font-size: clamp(2rem, 5vw, 3.75rem); letter-spacing: -0.015em;">
            {post.data.title}
          </h1>

          <div class="flex flex-wrap gap-2 text-sm text-white/80">
            <span>{t(displayLocale, 'blog.publishedOn')} {formatDate(post.data.publishDate, displayLocale)}</span>
            {post.data.readTime && (
              <>
                <span aria-hidden="true" class="text-gold">·</span>
                <span>{post.data.readTime} {t(displayLocale, 'blog.minutesRead')}</span>
              </>
            )}
            <span aria-hidden="true" class="text-gold">·</span>
            <span>{t(displayLocale, 'blog.by')} {post.data.author}</span>
          </div>
        </div>
      </header>
    )}

    <div class="py-16 md:py-20">
      <div class="article__content container">
        <Content />
      </div>
    </div>

    {related.length > 0 && (
      <section class="section bg-cream">
        <div class="container">
          <h2 class="h3 text-navy mb-8">{t(displayLocale, 'blog.title')}</h2>
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            {related.map((p, i) => (
              <a
                href={`/${displayLocale}/blog/${p.slug.replace(/-(es|en)$/, '')}`}
                class="reveal group block bg-white rounded-lg overflow-hidden transition-all duration-300 text-text-primary no-underline hover:-translate-y-1 hover:shadow-lg"
                style={`transition-delay:${i * 60}ms`}
              >
                {p.data.cover && (
                  <div class="aspect-[16/10] overflow-hidden">
                    <img
                      src={p.data.cover}
                      alt=""
                      loading="lazy"
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  </div>
                )}
                <div class="p-6">
                  <span class="text-[0.7rem] font-semibold tracking-[0.16em] uppercase text-gold">
                    {categoryLabel(p.data.category, displayLocale)}
                  </span>
                  <h3 class="font-serif text-lg text-navy mt-2 mb-4 leading-tight">
                    {p.data.title}
                  </h3>
                  <span class="text-xs tracking-[0.1em] uppercase text-gold font-semibold">
                    {t(displayLocale, 'blog.readMore')} →
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style is:global>
  /* Article prose styling for Markdown-rendered content */
  .article__content {
    max-width: 720px;
    margin-inline: auto;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-primary);
  }
  .article__content h2 {
    font-family: var(--font-sans);
    font-size: 1.85rem;
    color: var(--color-navy);
    margin-top: 3rem;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .article__content h3 {
    font-family: var(--font-sans);
    font-size: 1.4rem;
    color: var(--color-navy);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .article__content p { margin-bottom: 1.25rem; }
  .article__content ul, .article__content ol { margin-bottom: 1.5rem; padding-left: 1.5rem; }
  .article__content ul li { list-style: disc; margin-bottom: 0.5rem; }
  .article__content ol li { list-style: decimal; margin-bottom: 0.5rem; }
  .article__content a {
    color: var(--color-gold);
    border-bottom: 1px solid currentColor;
    transition: opacity var(--dur-base) var(--ease);
  }
  .article__content a:hover { opacity: 0.7; }
  .article__content blockquote {
    border-left: 3px solid var(--color-gold);
    padding: 0.25rem 0 0.25rem 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--color-navy);
    font-size: 1.15rem;
  }
  .article__content table {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .article__content th, .article__content td {
    text-align: left;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(10, 29, 63, 0.08);
  }
  .article__content th {
    background: var(--color-light);
    font-weight: 600;
    color: var(--color-navy);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }
  .article__content code {
    background: var(--color-light);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
    color: var(--color-navy);
  }
  .article__content strong { color: var(--color-navy); font-weight: 600; }
</style>
