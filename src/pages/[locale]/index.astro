---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, supportedLocales, type Locale } from '../../utils/i18n';
import { getProperties } from '../../data/property-source';
import { formatPrice, statusLabel } from '../../data/properties';

const locale = Astro.params.locale as Locale;

const { properties } = await getProperties();
const featuredProperties = properties.filter((property) => property.featured).slice(0, 3);
const homeProperties = featuredProperties.length > 0 ? featuredProperties : properties.slice(0, 3);

const regions = [
  { slug: 'salamanca', label: 'Salamanca' },
  { slug: 'chamberi', label: 'Chamberí' },
  { slug: 'chamartin', label: 'Chamartín' },
  { slug: 'retiro', label: 'Retiro' },
  { slug: 'jeronimos', label: 'Jerónimos' },
  { slug: 'justicia', label: 'Justicia' },
  { slug: 'almagro', label: 'Almagro' },
  { slug: 'castellana', label: 'Castellana' },
  { slug: 'el-viso', label: 'El Viso' },
  { slug: 'nuevos-ministerios', label: 'Nuevos Ministerios' },
  { slug: 'arguelles', label: 'Argüelles' },
  { slug: 'cortes', label: 'Cortes' },
  { slug: 'malasana', label: 'Malasaña' },
  { slug: 'la-latina', label: 'La Latina' },
];
export async function getStaticPaths() {
  return supportedLocales.map(locale => ({ params: { locale } }));
}

const neighborhoods = [
  { slug: 'salamanca-ibiza', label: 'SALAMANCA - IBIZA' },
  { slug: 'la-latina-sol', label: 'LA LATINA - SOL' },
  { slug: 'chamberi-malasana', label: 'CHAMBERI - MALASAÑA' },
  { slug: 'chueca-justicia', label: 'CHUECA - JUSTICIA' },
  { slug: 'atocha-pacifico', label: 'ATOCHA - PACIFICO' },
  { slug: 'chamartin-viso', label: 'CHAMARTIN - VISO' },
  { slug: 'rios-rosas-cuatro-caminos', label: 'RIOS ROSAS - CUATRO CAMINOS' },
];
const homeReviews = locale === 'es'
  ? [
      { name: 'Laura M.', source: 'Email verificado', text: 'Nos ayudaron a encontrar una vivienda en Madrid sin perder tiempo. La comunicaci&oacute;n fue clara desde el primer d&iacute;a.' },
      { name: 'Carlos R.', source: 'Cuenta Google', text: 'El proceso fue muy profesional. Coordinaci&oacute;n r&aacute;pida, buenas opciones y seguimiento despu&eacute;s de la visita.' },
      { name: 'Sofia P.', source: 'Email verificado', text: 'Global Move entendi&oacute; exactamente lo que necesit&aacute;bamos y nos acompa&ntilde;&oacute; en cada paso del alquiler.' },
    ]
  : [
      { name: 'Laura M.', source: 'Verified email', text: 'They helped us find a home in Madrid without wasting time. Communication was clear from day one.' },
      { name: 'Carlos R.', source: 'Google account', text: 'The process felt very professional. Fast coordination, strong options, and follow-up after the viewing.' },
      { name: 'Sofia P.', source: 'Verified email', text: 'Global Move understood exactly what we needed and supported us through every step of the rental.' },
    ];
---

<BaseLayout transparentHeader={true}>
  <!-- ============ HERO ============ -->
  <section class="home-hero relative min-h-[100svh] flex items-center justify-center text-white overflow-hidden">
    <div class="absolute inset-0 -z-0" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=75"
        alt=""
        loading="eager"
        fetchpriority="high"
        data-ken-burns
        class="w-full h-full object-cover"
        style="transition: none;"
      />
      <div class="absolute inset-0"
        style="background:
          linear-gradient(180deg, rgba(0,0,0,0.42) 0%, rgba(0,0,0,0.30) 42%, rgba(0,0,0,0.82) 100%),
          linear-gradient(90deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.10) 48%, rgba(0,0,0,0.35) 100%);"
      ></div>
    </div>

    <div class="container home-hero__content pt-[calc(var(--header-height)+5rem)] pb-24">
      <h1 class="home-hero__title reveal text-white"
          style="--reveal-delay: 120ms;">
        {locale === 'es'
          ? <><span class="home-hero__title-line">Haz una mudanza</span><span>para tu futuro</span></>
          : <><span class="home-hero__title-line">Make a Move For Your</span><span>Future</span></>}
      </h1>
      <p class="home-hero__subtitle reveal"
         style="--reveal-delay: 280ms;">
        {locale === 'es'
          ? 'La marca inmobiliaria con mayor seguimiento y suscriptores del mundo'
          : "Earth's Most Followed and Subscribed to Real Estate Brand"}
      </p>

      <form class="home-hero__search reveal" action={`/${locale}/properties/`} method="get" role="search" style="--reveal-delay: 420ms;">
        <label class="sr-only" for="home-search">
          {locale === 'es' ? 'Buscar propiedades' : 'Search properties'}
        </label>
        <span class="home-hero__search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </span>
        <input
          id="home-search"
          name="dest"
          type="search"
          autocomplete="off"
          placeholder={locale === 'es'
            ? 'Busca propiedades, ubicaciones...'
            : 'Search properties, locations...'}
        />
        <button type="submit" aria-label={locale === 'es' ? 'Buscar' : 'Search'}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </button>
      </form>
    </div>

  </section>

  <section class="home-regions" aria-labelledby="regions-heading">
    <div class="container">
      <h2 id="regions-heading" class="home-section-title reveal">
        {locale === 'es' ? 'Nuestros barrios' : 'Our Neighborhoods'}
      </h2>
      <div class="home-regions__grid reveal reveal--fade">
        {neighborhoods.map((region) => (
          <a class="home-region-pill" href={`/${locale}/properties/?dest=madrid&zone=${region.slug}`}>
            <span>{region.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-featured" aria-labelledby="featured-heading">
    <div class="container">
      <header class="home-featured__header reveal">
        <h2 id="featured-heading" class="home-section-title">
          {locale === 'es' ? 'Propiedades destacadas' : 'Featured Properties'}
        </h2>
        <p>
          {locale === 'es'
            ? 'Explora algunas de nuestras casas, apartamentos y villas más exclusivas.'
            : 'Check out some of our most exclusive houses, apartments, villas, and more.'}
        </p>
      </header>

      <div class="home-properties-grid">
        {homeProperties.map((property) => (
          <a class="home-property-card reveal reveal--fade" href={`/${locale}/properties/${property.slug}/`}>
            <figure class="home-property-card__media">
              <img
                src={property.images[0]}
                alt={property.name[locale]}
                loading="lazy"
                decoding="async"
                sizes="(max-width: 720px) 100vw, 33vw"
                style={`object-position: ${property.imagePosition ?? 'center 62%'};`}
              />
              <span class="home-property-card__transaction">
                {property.transaction === 'sale'
                  ? (locale === 'es' ? 'Venta' : 'Sale')
                  : (locale === 'es' ? 'Alquiler' : 'Rent')}
              </span>
              <figcaption>{locale === 'es' ? 'GLOBAL.MOVE Selección' : 'GLOBAL.MOVE Signature'}</figcaption>
            </figure>
            <div class="home-property-card__body">
              <div class="home-property-card__badges">
                <span class={`home-property-card__status home-property-card__status--${property.status}`}>
                  {statusLabel(property.status, locale)}
                </span>
              </div>
              <strong>{formatPrice(property.price, locale)}</strong>
              <p>{property.location[locale]}</p>
              <dl>
                {property.bedrooms && (
                  <div>
                    <dd>{property.bedrooms}</dd>
                    <dt>{locale === 'es' ? 'DORM.' : 'BEDS'}</dt>
                  </div>
                )}
                {property.bathrooms && (
                  <div>
                    <dd>{property.bathrooms}</dd>
                    <dt>{locale === 'es' ? 'BAÑOS' : 'FULL BATHS'}</dt>
                  </div>
                )}
                {property.sizeM2 && (
                  <div>
                    <dd>{property.sizeM2}</dd>
                    <dt>{locale === 'es' ? 'M²' : 'SQ.FT.'}</dt>
                  </div>
                )}
              </dl>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-reviews" aria-labelledby="reviews-heading">
    <div class="container">
      <div class="home-reviews__layout">
        <div class="home-reviews__content reveal">
          <span class="home-reviews__eyebrow">
            <span set:html={locale === 'es' ? 'Rese&ntilde;as verificadas' : 'Verified Reviews'}></span>
          </span>
          <h2 id="reviews-heading" class="home-section-title">
            {locale === 'es' ? 'Lo que dicen nuestros clientes' : 'What Our Clients Say'}
          </h2>
          <p set:html={locale === 'es'
            ? 'Solo publicamos rese&ntilde;as asociadas a una cuenta de Google o a un email verificado por nuestro equipo.'
            : 'We only publish reviews linked to a Google account or to an email verified by our team.'}
          ></p>

          <div class="home-reviews__list">
            {homeReviews.map((review) => (
              <article class="home-review-card reveal reveal--fade">
                <div class="home-review-card__stars" aria-label={locale === 'es' ? '5 de 5 estrellas' : '5 out of 5 stars'}>&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                <p set:html={review.text}></p>
                <footer>
                  <strong>{review.name}</strong>
                  <span>{review.source}</span>
                </footer>
              </article>
            ))}
          </div>
        </div>

        <form
          class="home-review-form reveal reveal--fade"
          name="home-review"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          data-loading-on-submit
        >
          <input type="hidden" name="form-name" value="home-review" />
          <p class="home-review-form__hidden">
            <label>Do not fill this field <input name="bot-field" /></label>
          </p>

          <h3 set:html={locale === 'es' ? 'Deja tu rese&ntilde;a' : 'Leave a Review'}></h3>
          <p
            class="home-review-form__note"
            set:html={locale === 'es'
              ? 'Usa tu correo o cuenta Google. Revisaremos la rese&ntilde;a antes de publicarla.'
              : 'Use your email or Google account. We will review it before publishing.'}
          ></p>

          <label>
            <span>{locale === 'es' ? 'Nombre' : 'Name'}</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>

          <label>
            <span>{locale === 'es' ? 'Email registrado o Google' : 'Registered or Google email'}</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>

          <div class="home-review-form__rating" role="radiogroup" aria-label={locale === 'es' ? 'Valoracion' : 'Rating'}>
            {[5, 4, 3, 2, 1].map((rating) => (
              <label>
                <input type="radio" name="rating" value={rating} required={rating === 5} />
                <span>{String.fromCharCode(9733).repeat(rating)}</span>
              </label>
            ))}
          </div>

          <label>
            <span>{locale === 'es' ? 'Comentario' : 'Comment'}</span>
            <textarea name="comment" rows="4" required></textarea>
          </label>

          <button type="submit">
            <span set:html={locale === 'es' ? 'Enviar rese&ntilde;a' : 'Submit Review'}></span>
          </button>
        </form>
      </div>
    </div>
  </section>
  <!-- ============ CTA ============ -->
  <section class="section section--cta grain" aria-labelledby="cta-heading">
    <div class="container">
      <div class="reveal reveal--scale relative rounded-2xl overflow-hidden text-white">
        <div class="absolute inset-0"
          style="background:
            linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-700) 100%),
            radial-gradient(at top right, var(--color-gold) 0%, transparent 50%);
            background-blend-mode: normal;">
        </div>
        <div class="absolute inset-0"
          style="background-image:
            radial-gradient(circle at 90% 10%, rgba(200,167,106,0.35) 0%, transparent 35%),
            radial-gradient(circle at 10% 90%, rgba(200,167,106,0.15) 0%, transparent 30%);">
        </div>
        <div class="relative text-center max-w-2xl mx-auto"
             style="padding: clamp(3rem, 6vw, 5rem);">
          <h2 class="h2 text-white mb-4">{t(locale, 'cta.headline')}</h2>
          <p class="lead text-white/80 mx-auto mb-9"
             style="font-size: clamp(1.1rem, 1.5vw, 1.3rem);">
            {t(locale, 'cta.subheadline')}
          </p>
          <a href={`/${locale}/contact/`} class="btn btn--primary" data-magnetic="0.35">
            <span data-magnetic-inner>{t(locale, 'cta.button')}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .home-hero {
    isolation: isolate;
  }

  .home-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 1160px;
  }

  .home-hero__title {
    max-width: 1040px;
    margin: 0 0 1.25rem;
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 36px;
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: 0;
    text-wrap: balance;
    text-shadow: 0 8px 34px rgba(0, 0, 0, 0.28);
  }

  .home-hero__title span {
    display: block;
  }

  .home-hero__title-line {
    white-space: nowrap;
  }

  .home-hero__subtitle {
    max-width: 780px;
    margin: 0 0 2.4rem;
    color: rgba(255, 255, 255, 0.94);
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 16px;
    line-height: 1.45;
    font-weight: 700;
    text-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
  }

  .home-hero__search {
    width: min(100%, 900px);
    min-height: 86px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem 0.85rem 2rem;
    background: var(--color-white);
    color: var(--color-navy);
    border-radius: 999px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28);
  }

  .home-hero__search-icon {
    display: inline-flex;
    width: 24px;
    height: 24px;
    color: rgba(10, 29, 63, 0.36);
  }

  .home-hero__search-icon svg,
  .home-hero__search button svg {
    width: 100%;
    height: 100%;
  }

  .home-hero__search input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-navy);
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 14px;
    line-height: 14px;
    font-weight: 700;
  }

  .home-hero__search input::placeholder {
    color: rgba(10, 29, 63, 0.24);
    opacity: 1;
  }

  .home-hero__search button {
    width: 62px;
    height: 62px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    background: #0b42df;
    border-radius: 999px;
    transition: transform var(--dur-base) var(--ease), background var(--dur-base) var(--ease);
  }

  .home-regions {
    padding-block: clamp(4rem, 7vw, 6.5rem);
    background: #f4f4f4;
  }

  .home-regions .home-section-title {
    font-size: 24px;
    line-height: 1.14;
  }

  .home-section-title {
    color: #071b68;
    font-size: clamp(2.6rem, 5.6vw, 4.8rem);
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0;
  }

  .home-regions__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 0.85rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  .home-region-pill {
    min-height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.85rem 1rem;
    background: var(--color-white);
    color: #071b68;
    border: 1px solid rgba(7, 27, 104, 0.04);
    border-radius: 8px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.035);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0;
    text-align: center;
    transition: background var(--dur-base) var(--ease), color var(--dur-base) var(--ease), transform var(--dur-base) var(--ease);
  }

  .home-region-pill:hover {
    background: #071b68;
    color: var(--color-white);
    transform: translateY(-1px);
  }

  .home-region-pill svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .home-featured {
    padding-block: clamp(4.5rem, 8vw, 7rem);
    background: var(--color-white);
  }

  .home-featured__header {
    max-width: 680px;
    margin-bottom: clamp(3.1rem, 5.8vw, 5.4rem);
  }

  .home-featured .home-section-title {
    font-size: clamp(2.65rem, 5.1vw, 4.4rem);
    line-height: 0.98;
  }

  .home-featured__header p {
    margin-top: 1.35rem;
    color: #4a4f58;
    font-size: clamp(1.12rem, 1.35vw, 1.42rem);
    line-height: 1.36;
    font-weight: 500;
  }

  .home-properties-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.6rem);
  }

  .home-property-card {
    color: #000;
  }

  .home-property-card__media {
    position: relative;
    aspect-ratio: 1.5 / 1;
    overflow: hidden;
    border-radius: 8px;
    background: #e7e7e7;
    margin: 0 0 1.18rem;
  }

  .home-property-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .home-property-card:hover .home-property-card__media img {
    transform: scale(1.035);
  }

  .home-property-card__status {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.5rem 0.92rem;
    background: rgba(255, 255, 255, 0.92);
    color: #071b68;
    border-radius: 4px;
    font-size: 0.82rem;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-property-card__media figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: 82%;
    padding: 0.7rem 1rem 0.72rem;
    background: #000;
    color: #fff;
    border-top-right-radius: 999px;
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.15;
  }

  .home-property-card__body strong {
    display: block;
    color: #000;
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 14px;
    line-height: 1.2;
    font-weight: 700;
    margin-bottom: 0.45rem;
  }

  .home-property-card__body p {
    color: #000;
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 16px;
    line-height: 1.35;
    font-weight: 500;
    margin-bottom: 1.15rem;
  }

  .home-property-card__body dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.52rem 0.86rem;
    color: #000;
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 12px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .home-property-card__badges {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 0.72rem;
  }

  .home-property-card__transaction {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.5rem 0.92rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.94);
    color: #071b68;
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 0.82rem;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-property-card__status--available {
    background: #e8f7ef;
    color: #057a45;
    border: 1px solid rgba(5, 122, 69, 0.16);
  }

  .home-property-card__body dl div {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28rem;
  }

  .home-property-card__body dl div + div::before {
    content: ".";
    margin-right: 0.35rem;
  }

  .home-property-card__body dt,
  .home-property-card__body dd {
    margin: 0;
  }

  .home-reviews {
    padding-block: clamp(4.5rem, 8vw, 7rem);
    background: #f4f4f4;
  }

  .home-reviews__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.72fr);
    gap: clamp(2rem, 4.6vw, 4.5rem);
    align-items: start;
  }

  .home-reviews__eyebrow {
    display: inline-flex;
    margin-bottom: 0.9rem;
    color: #071b68;
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 12px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-reviews__content > p {
    max-width: 42rem;
    margin-top: 1.1rem;
    color: #4a4f58;
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 16px;
    line-height: 1.45;
    font-weight: 500;
  }

  .home-reviews__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: clamp(2rem, 4vw, 3.2rem);
  }

  .home-review-card {
    min-height: 228px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    background: #fff;
