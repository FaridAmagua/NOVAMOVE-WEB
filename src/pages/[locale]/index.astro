---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, localeParams, type Locale } from '../../utils/i18n';

const locale = Astro.params.locale as Locale;

const services = [
  { key: 'relocation', icon: 'home',   href: '/services#relocation' },
  { key: 'rentals',    icon: 'key',    href: '/services#rentals' },
  { key: 'sales',      icon: 'globe',  href: '/services#sales' },
  { key: 'concierge',  icon: 'bell',   href: '/services#concierge' },
];

const destinations = [
  { key: 'madrid',     img: 'https://images.unsplash.com/photo-1543783207-ec64e4d95325?w=900&q=80' },
  { key: 'barcelona',  img: 'https://images.unsplash.com/photo-1583422409516-2895a77efded?w=900&q=80' },
  { key: 'marbella',   img: 'https://images.unsplash.com/photo-1513519245088-0e12902e5a38?w=900&q=80' },
  { key: 'mallorca',   img: 'https://images.unsplash.com/photo-1599809275671-b5942cabc7a2?w=900&q=80' },
  { key: 'ibiza',      img: 'https://images.unsplash.com/photo-1559656914-a30970c1affd?w=900&q=80' },
  { key: 'canarias',   img: 'https://images.unsplash.com/photo-1505939435612-a18ea96b80b3?w=900&q=80' },
];

const process = ['discovery', 'planning', 'execution', 'settling'] as const;
const testimonials = ['one', 'two', 'three'] as const;
export async function getStaticPaths() {
  return localeParams;
}
---

<BaseLayout transparentHeader={true}>
  <!-- ============ HERO ============ -->
  <section class="relative min-h-[100svh] flex items-center text-white overflow-hidden">
    <div class="absolute inset-0 -z-0" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=2000&q=80"
        alt=""
        loading="eager"
        fetchpriority="high"
        data-ken-burns
        data-parallax="0.15"
        class="w-full h-full object-cover"
        style="transition: none;"
      />
      <div class="absolute inset-0"
        style="background:
          linear-gradient(135deg, rgba(10,29,63,0.85) 0%, rgba(10,29,63,0.55) 60%, rgba(10,29,63,0.4) 100%),
          linear-gradient(180deg, rgba(10,29,63,0.4) 0%, rgba(10,29,63,0.6) 100%);"
      ></div>
    </div>

    <div class="container max-w-[880px] pt-[calc(var(--header-height)+4rem)] pb-24">
      <p class="eyebrow eyebrow--light reveal reveal--blur">{t(locale, 'hero.eyebrow')}</p>
      <h1 class="reveal text-white font-medium leading-[1.02] mb-7"
          style="font-size: clamp(3rem, 7.5vw, 6.5rem); letter-spacing: -0.02em; --reveal-delay: 120ms;">
        {locale === 'es' ? (
          <>Te movemos,<br/><span class="italic-serif">vives mejor.</span></>
        ) : (
          <>We move you,<br/><span class="italic-serif">you live better.</span></>
        )}
      </h1>
      <p class="reveal max-w-[56ch] mb-10"
         style="font-size: clamp(1.05rem, 1.4vw, 1.25rem); line-height: 1.6; color: rgba(255,255,255,0.85); --reveal-delay: 280ms;">
        {t(locale, 'hero.subheadline')}
      </p>
      <div class="flex flex-wrap gap-4 reveal" style="--reveal-delay: 420ms;">
        <a href={`/${locale}/contact`} class="btn btn--primary" data-magnetic="0.3">
          <span data-magnetic-inner>{t(locale, 'hero.primaryCta')}</span>
        </a>
        <a href={`/${locale}/destinations`} class="btn btn--ghost" data-magnetic="0.3">
          <span data-magnetic-inner>{t(locale, 'hero.secondaryCta')}</span>
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 w-6 h-10 border-[1.5px] border-white/50 rounded-xl flex justify-center pt-2" aria-hidden="true">
      <span class="block w-0.5 h2 bg-gold rounded-sm" style="animation: scrollHint 1.6s ease-in-out infinite;"></span>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <div class="max-w-3xl mb-16">
        <p class="eyebrow">{t(locale, 'services.eyebrow')}</p>
        <h2 id="services-heading" class="h2 mt-4 mb-4">{t(locale, 'services.headline')}</h2>
        <p class="lead mt-0">{t(locale, 'services.subheadline')}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" data-stagger data-stagger-step="100">
        {services.map(({ key, icon, href }) => (
          <a href={`/${locale}${href}`}
             class="reveal reveal--fade group flex flex-col p-9 bg-white border border-navy/5 rounded-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:border-gold text-text-primary no-underline"
             data-tilt="4">
            <span class="inline-flex items-center justify-center w-14 h-14 rounded-lg text-gold mb-6"
                  style="background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-700) 100%);" aria-hidden="true">
              {icon === 'home' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><path d="M3 12l9-9 9 9M5 10v10h14V10"/></svg>}
              {icon === 'key' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><circle cx="8" cy="15" r="4"/><path d="m11 12 9-9 2 2-2 2 2 2-3 3-2-2-3 3"/></svg>}
              {icon === 'globe' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>}
              {icon === 'bell' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10 21a2 2 0 0 0 4 0"/></svg>}
            </span>
            <h3 class="font-serif text-2xl font-medium text-navy mb-3">{t(locale, `services.items.${key}.title`)}</h3>
            <p class="text-[0.95rem] leading-relaxed text-text-secondary flex-1 mb-6">{t(locale, `services.items.${key}.description`)}</p>
            <span class="text-xl text-gold transition-transform duration-300 group-hover:translate-x-1.5" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <div class="reveal reveal--fade mt-12 text-left">
        <a href={`/${locale}/services`} class="btn btn--link">{t(locale, 'services.cta')}</a>
      </div>
    </div>
  </section>

  <!-- ============ DESTINATIONS ============ -->
  <section class="section section--dark" aria-labelledby="destinations-heading">
    <div class="container">
      <header class="reveal max-w-3xl mx-auto mb-16 text-center">
        <p class="eyebrow eyebrow--light">{t(locale, 'destinations.eyebrow')}</p>
        <h2 id="destinations-heading" class="h2">{t(locale, 'destinations.headline')}</h2>
        <p class="lead">{t(locale, 'destinations.subheadline')}</p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-stagger data-stagger-step="80">
        {destinations.map(({ key, img }) => (
          <a href={`/${locale}/destinations#${key}`}
             class="reveal reveal--scale group relative block overflow-hidden rounded-lg aspect-[4/5] text-white no-underline"
             data-tilt="3">
            <div class="absolute inset-0">
              <img src={img} alt="" loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            </div>
            <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 30%, rgba(10,29,63,0.85) 100%);"></div>
            <div class="absolute bottom-0 left-0 right-0 p-7 z-10">
              <h3 class="font-serif text-[1.6rem] text-white mb-1">{t(locale, `destinations.items.${key}.name`)}</h3>
              <p class="text-[0.85rem] text-white/80 leading-snug">{t(locale, `destinations.items.${key}.tag`)}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="reveal mt-12 text-center">
        <a href={`/${locale}/destinations`} class="btn btn--link btn--link-light">{t(locale, 'destinations.cta')}</a>
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="section" aria-labelledby="process-heading">
    <div class="container">
      <header class="reveal max-w-3xl mx-auto mb-16 text-center">
        <p class="eyebrow">{t(locale, 'process.eyebrow')}</p>
        <h2 id="process-heading" class="h2">{t(locale, 'process.headline')}</h2>
        <p class="lead">{t(locale, 'process.subheadline')}</p>
      </header>

      <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8" data-stagger data-stagger-step="120">
        {process.map((step, i) => (
          <li class="reveal reveal--left relative pt-6">
            <span class="absolute top-0 left-0 w-full h-px"
              style="background: linear-gradient(90deg, var(--color-gold) 0%, transparent 80%);"></span>
            <span class="block font-serif text-4xl text-gold leading-none font-semibold mb-5 tracking-tight">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="font-serif text-xl text-navy mb-3 font-semibold">{t(locale, `process.steps.${step}.title`)}</h3>
            <p class="text-[0.95rem] leading-relaxed text-text-secondary">{t(locale, `process.steps.${step}.description`)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="section section--subtle" aria-labelledby="testimonials-heading">
    <div class="container">
      <header class="reveal max-w-3xl mx-auto mb-16 text-center">
        <p class="eyebrow">{t(locale, 'testimonials.eyebrow')}</p>
        <h2 id="testimonials-heading" class="h2">{t(locale, 'testimonials.headline')}</h2>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8" data-stagger data-stagger-step="120">
        {testimonials.map((id) => (
          <figure class="reveal reveal--fade relative bg-white p-10 md:p-8 rounded-lg shadow-sm">
            <span class="absolute -top-2.5 left-6 font-serif text-8xl text-gold leading-none" aria-hidden="true">"</span>
            <blockquote class="m-0 mb-6">
              <p class="font-serif text-lg leading-snug text-navy italic">{t(locale, `testimonials.items.${id}.quote`)}</p>
            </blockquote>
            <figcaption class="flex flex-col gap-1 pt-5 border-t border-navy/5">
              <span class="font-semibold text-navy text-[0.92rem]">{t(locale, `testimonials.items.${id}.author`)}</span>
              <span class="text-[0.82rem] text-gold tracking-[0.06em]">{t(locale, `testimonials.items.${id}.origin`)}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section section--cta grain" aria-labelledby="cta-heading">
    <div class="container">
      <div class="reveal reveal--scale relative rounded-2xl overflow-hidden text-white">
        <div class="absolute inset-0"
          style="background:
            linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-700) 100%),
            radial-gradient(at top right, var(--color-gold) 0%, transparent 50%);
            background-blend-mode: normal;">
        </div>
        <div class="absolute inset-0"
          style="background-image:
            radial-gradient(circle at 90% 10%, rgba(200,167,106,0.35) 0%, transparent 35%),
            radial-gradient(circle at 10% 90%, rgba(200,167,106,0.15) 0%, transparent 30%);">
        </div>
        <div class="relative text-center max-w-2xl mx-auto"
             style="padding: clamp(3rem, 6vw, 5rem);">
          <h2 class="h2 text-white mb-4">{t(locale, 'cta.headline')}</h2>
          <p class="lead text-white/80 mx-auto mb-9"
             style="font-size: clamp(1.1rem, 1.5vw, 1.3rem);">
            {t(locale, 'cta.subheadline')}
          </p>
          <a href={`/${locale}/contact`} class="btn btn--primary" data-magnetic="0.35">
            <span data-magnetic-inner>{t(locale, 'cta.button')}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Hero scroll-indicator animation */
  @keyframes scrollHint {
    0% { transform: translateY(0); opacity: 1; }
    100% { transform: translateY(14px); opacity: 0; }
  }
</style>
