---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, supportedLocales, type Locale } from '../../utils/i18n';
import { getProperties, zoneLabel } from '../../data/property-source';
import { formatPrice, statusLabel } from '../../data/properties';

const locale = Astro.params.locale as Locale;

const { properties } = await getProperties();
const featuredProperties = properties.filter((property) => property.featured).slice(0, 3);
const homeProperties = featuredProperties.length > 0 ? featuredProperties : properties.slice(0, 3);

const regions = [
  'madrid',
  'barcelona',
  'marbella',
  'mallorca',
  'ibiza',
  'canarias',
  'valencia',
  'sevilla',
  'malaga',
  'sitges',
  'palma',
  'alicante',
  'bilbao',
  'tenerife',
];
export async function getStaticPaths() {
  return supportedLocales.map(locale => ({ params: { locale } }));
}
---

<BaseLayout transparentHeader={true}>
  <!-- ============ HERO ============ -->
  <section class="home-hero relative min-h-[100svh] flex items-center justify-center text-white overflow-hidden">
    <div class="absolute inset-0 -z-0" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=75"
        alt=""
        loading="eager"
        fetchpriority="high"
        data-ken-burns
        class="w-full h-full object-cover"
        style="transition: none;"
      />
      <div class="absolute inset-0"
        style="background:
          linear-gradient(180deg, rgba(0,0,0,0.42) 0%, rgba(0,0,0,0.30) 42%, rgba(0,0,0,0.82) 100%),
          linear-gradient(90deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.10) 48%, rgba(0,0,0,0.35) 100%);"
      ></div>
    </div>

    <div class="container home-hero__content pt-[calc(var(--header-height)+5rem)] pb-24">
      <h1 class="home-hero__title reveal text-white"
          style="--reveal-delay: 120ms;">
        {locale === 'es' ? (
          <>Te movemos,<br/><span class="">vives mejor.</span></>
        ) : (
          <>We move you,<br/><span class="">you live better.</span></>
        )}
      </h1>
      <p class="home-hero__subtitle reveal"
         style="--reveal-delay: 280ms;">
        {t(locale, 'hero.subheadline')}
      </p>

      <form class="home-hero__search reveal" action={`/${locale}/properties/`} method="get" role="search" style="--reveal-delay: 420ms;">
        <label class="sr-only" for="home-search">
          {locale === 'es' ? 'Buscar propiedades' : 'Search properties'}
        </label>
        <span class="home-hero__search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </span>
        <input
          id="home-search"
          name="dest"
          type="search"
          autocomplete="off"
          placeholder={locale === 'es'
            ? 'Busca propiedades, ubicaciones...'
            : 'Search properties, locations...'}
        />
        <button type="submit" aria-label={locale === 'es' ? 'Buscar' : 'Search'}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </button>
      </form>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 w-6 h-10 border-[1.5px] border-white/50 rounded-xl flex justify-center pt-2" aria-hidden="true">
      <span class="block w-0.5 h2 bg-white rounded-sm" style="animation: scrollHint 1.6s ease-in-out infinite;"></span>
    </div>
  </section>

  <section class="home-regions" aria-labelledby="regions-heading">
    <div class="container">
      <h2 id="regions-heading" class="home-section-title reveal">
        {locale === 'es' ? 'Nuestras regiones' : 'Our Regions'}
      </h2>
      <div class="home-regions__grid reveal reveal--fade">
        {regions.map((region) => (
          <a class="home-region-pill" href={`/${locale}/properties/?dest=${region}`}>
            <span>{zoneLabel(region, locale)}</span>
            {['barcelona', 'marbella', 'ibiza', 'madrid'].includes(region) && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                <path d="M9 18l6-6-6-6"></path>
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-featured" aria-labelledby="featured-heading">
    <div class="container">
      <header class="home-featured__header reveal">
        <h2 id="featured-heading" class="home-section-title">
          {locale === 'es' ? 'Propiedades destacadas' : 'Featured Properties'}
        </h2>
        <p>
          {locale === 'es'
            ? 'Explora algunas de nuestras casas, apartamentos y villas mas exclusivas.'
            : 'Check out some of our most exclusive houses, apartments, villas, and more.'}
        </p>
      </header>

      <div class="home-properties-grid">
        {homeProperties.map((property) => (
          <a class="home-property-card reveal reveal--fade" href={`/${locale}/properties/${property.slug}/`}>
            <figure class="home-property-card__media">
              <img
                src={property.images[0]}
                alt={property.name[locale]}
                loading="lazy"
                decoding="async"
                sizes="(max-width: 720px) 100vw, 33vw"
                style={`object-position: ${property.imagePosition ?? 'center 62%'};`}
              />
              <span class="home-property-card__status">
                {statusLabel(property.status, locale)}
              </span>
              <figcaption>{property.name[locale]}</figcaption>
            </figure>
            <div class="home-property-card__body">
              <strong>{formatPrice(property.price, locale)}</strong>
              <p>{property.location[locale]}</p>
              <dl>
                {property.bedrooms && (
                  <div>
                    <dt>{locale === 'es' ? 'Dorm.' : 'Beds'}</dt>
                    <dd>{property.bedrooms}</dd>
                  </div>
                )}
                {property.bathrooms && (
                  <div>
                    <dt>{locale === 'es' ? 'Banos' : 'Baths'}</dt>
                    <dd>{property.bathrooms}</dd>
                  </div>
                )}
                {property.sizeM2 && (
                  <div>
                    <dt>m2</dt>
                    <dd>{property.sizeM2}</dd>
                  </div>
                )}
              </dl>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section section--cta grain" aria-labelledby="cta-heading">
    <div class="container">
      <div class="reveal reveal--scale relative rounded-2xl overflow-hidden text-white">
        <div class="absolute inset-0"
          style="background:
            linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-700) 100%),
            radial-gradient(at top right, var(--color-gold) 0%, transparent 50%);
            background-blend-mode: normal;">
        </div>
        <div class="absolute inset-0"
          style="background-image:
            radial-gradient(circle at 90% 10%, rgba(200,167,106,0.35) 0%, transparent 35%),
            radial-gradient(circle at 10% 90%, rgba(200,167,106,0.15) 0%, transparent 30%);">
        </div>
        <div class="relative text-center max-w-2xl mx-auto"
             style="padding: clamp(3rem, 6vw, 5rem);">
          <h2 class="h2 text-white mb-4">{t(locale, 'cta.headline')}</h2>
          <p class="lead text-white/80 mx-auto mb-9"
             style="font-size: clamp(1.1rem, 1.5vw, 1.3rem);">
            {t(locale, 'cta.subheadline')}
          </p>
          <a href={`/${locale}/contact/`} class="btn btn--primary" data-magnetic="0.35">
            <span data-magnetic-inner>{t(locale, 'cta.button')}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .home-hero {
    isolation: isolate;
  }

  .home-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 1160px;
  }

  .home-hero__title {
    max-width: 1040px;
    margin: 0 0 1.25rem;
    font-size: clamp(3.5rem, 8vw, 7.4rem);
    line-height: 0.98;
    font-weight: 800;
    letter-spacing: 0;
    text-wrap: balance;
    text-shadow: 0 8px 34px rgba(0, 0, 0, 0.28);
  }

  .home-hero__subtitle {
    max-width: 780px;
    margin: 0 0 2.4rem;
    color: rgba(255, 255, 255, 0.94);
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.45;
    font-weight: 800;
    text-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
  }

  .home-hero__search {
    width: min(100%, 900px);
    min-height: 86px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem 0.85rem 2rem;
    background: var(--color-white);
    color: var(--color-navy);
    border-radius: 999px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28);
  }

  .home-hero__search-icon {
    display: inline-flex;
    width: 24px;
    height: 24px;
    color: rgba(10, 29, 63, 0.36);
  }

  .home-hero__search-icon svg,
  .home-hero__search button svg {
    width: 100%;
    height: 100%;
  }

  .home-hero__search input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-navy);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .home-hero__search input::placeholder {
    color: rgba(10, 29, 63, 0.24);
    opacity: 1;
  }

  .home-hero__search button {
    width: 62px;
    height: 62px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    background: #0b42df;
    border-radius: 999px;
    transition: transform var(--dur-base) var(--ease), background var(--dur-base) var(--ease);
  }

  .home-regions {
    padding-block: clamp(4rem, 7vw, 6.5rem);
    background: #f4f4f4;
  }

  .home-section-title {
    color: #071b68;
    font-size: clamp(2.6rem, 5.6vw, 4.8rem);
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0;
  }

  .home-regions__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.7rem 0.85rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  .home-region-pill {
    min-height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.85rem 1rem;
    background: var(--color-white);
    color: #071b68;
    border: 1px solid rgba(7, 27, 104, 0.04);
    border-radius: 8px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.035);
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0;
    text-align: center;
    transition: background var(--dur-base) var(--ease), color var(--dur-base) var(--ease), transform var(--dur-base) var(--ease);
  }

  .home-region-pill:hover {
    background: #071b68;
    color: var(--color-white);
    transform: translateY(-1px);
  }

  .home-region-pill svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .home-featured {
    padding-block: clamp(4.5rem, 8vw, 7rem);
    background: var(--color-white);
  }

  .home-featured__header {
    max-width: 720px;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .home-featured__header p {
    margin-top: 1.2rem;
    color: #4a4f58;
    font-size: clamp(1rem, 1.35vw, 1.3rem);
    line-height: 1.42;
    font-weight: 500;
  }

  .home-properties-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.6rem);
  }

  .home-property-card {
    color: #000;
  }

  .home-property-card__media {
    position: relative;
    aspect-ratio: 1.48 / 1;
    overflow: hidden;
    border-radius: 8px;
    background: #e7e7e7;
    margin: 0 0 1.05rem;
  }

  .home-property-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .home-property-card:hover .home-property-card__media img {
    transform: scale(1.035);
  }

  .home-property-card__status {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.42rem 0.8rem;
    background: rgba(255, 255, 255, 0.92);
    color: #071b68;
    border-radius: 4px;
    font-size: 0.78rem;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-property-card__media figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: 82%;
    padding: 0.7rem 1rem 0.72rem;
    background: #000;
    color: #fff;
    border-top-right-radius: 999px;
    font-size: clamp(0.98rem, 1.2vw, 1.18rem);
    font-weight: 800;
    line-height: 1.15;
  }

  .home-property-card__body strong {
    display: block;
    color: #000;
    font-size: clamp(1.05rem, 1.3vw, 1.25rem);
    line-height: 1.2;
    font-weight: 900;
    margin-bottom: 0.45rem;
  }

  .home-property-card__body p {
    color: #000;
    font-size: clamp(0.98rem, 1.2vw, 1.12rem);
    line-height: 1.35;
    font-weight: 600;
    margin-bottom: 1.05rem;
  }

  .home-property-card__body dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
    color: #000;
    font-size: 0.8rem;
    line-height: 1.2;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .home-property-card__body div {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28rem;
  }

  .home-property-card__body div + div::before {
    content: ".";
    margin-right: 0.35rem;
  }

  .home-property-card__body dt,
  .home-property-card__body dd {
    margin: 0;
  }

  .home-hero__search button:hover {
    background: #0733ad;
    transform: translateY(-1px);
  }

  .home-hero__search button svg {
    width: 25px;
    height: 25px;
  }

  @media (max-width: 720px) {
    .home-hero__content {
      padding-top: calc(var(--header-height) + 4rem);
      padding-bottom: 6rem;
    }

    .home-hero__title {
      font-size: clamp(3rem, 15vw, 4.6rem);
      margin-bottom: 1rem;
    }

    .home-hero__subtitle {
      margin-bottom: 1.7rem;
      font-size: 0.98rem;
    }

    .home-hero__search {
      min-height: 68px;
      gap: 0.7rem;
      padding: 0.65rem 0.7rem 0.65rem 1.25rem;
    }

    .home-hero__search-icon {
      width: 20px;
      height: 20px;
    }

    .home-hero__search input {
      font-size: 0.92rem;
    }

    .home-hero__search button {
      width: 50px;
      height: 50px;
    }

    .home-hero__search button svg {
      width: 21px;
      height: 21px;
    }

    .home-regions,
    .home-featured {
      padding-block: 3.25rem;
    }

    .home-regions__grid,
    .home-properties-grid {
      grid-template-columns: 1fr;
    }

    .home-section-title {
      font-size: clamp(2.5rem, 13vw, 3.5rem);
    }

    .home-region-pill {
      min-height: 54px;
      justify-content: space-between;
      padding-inline: 1.1rem;
      text-align: left;
    }

    .home-property-card__media {
      aspect-ratio: 1.34 / 1;
    }
  }

  /* Hero scroll-indicator animation */
  @keyframes scrollHint {
    0% { transform: translateY(0); opacity: 1; }
    100% { transform: translateY(14px); opacity: 0; }
  }
</style>
