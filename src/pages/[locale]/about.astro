---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t, localeParams, type Locale } from '../../utils/i18n';

const locale = Astro.params.locale as Locale;
const values = ['excellence', 'trust', 'humanity', 'global'] as const;
export async function getStaticPaths() {
  return localeParams;
}
---

<BaseLayout
  title={t(locale, 'about.title')}
  transparentHeader={true}
>
  <PageHero
    eyebrow={t(locale, 'about.title')}
    title={t(locale, 'about.subtitle')}
    image="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=2000&q=80"
  />

  <!-- Mission -->
  <section class="section">
    <div class="container">
      <div class="about-mission reveal">
        <p class="eyebrow">{t(locale, 'about.mission.title')}</p>
        <p class="h-2 italic-serif">{t(locale, 'about.mission.body')}</p>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section section--subtle" aria-labelledby="values-heading">
    <div class="container">
      <header class="section-header reveal">
        <p class="eyebrow">{t(locale, 'about.values.title')}</p>
        <h2 id="values-heading" class="h-2">{t(locale, 'about.values.title')}</h2>
      </header>

      <div class="values-grid" data-stagger data-stagger-step="120">
        {values.map((v, i) => (
          <div class="value-card reveal reveal--fade" data-tilt="3">
            <span class="value-card__num">0{i + 1}</span>
            <h3 class="value-card__title">{t(locale, `about.values.items.${v}.title`)}</h3>
            <p>{t(locale, `about.values.items.${v}.description`)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section">
    <div class="container">
      <div class="team-grid">
        <div class="team-grid__media reveal">
          <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=1400&q=80" alt="" loading="lazy" />
        </div>
        <div class="team-grid__body reveal">
          <p class="eyebrow">{t(locale, 'about.team.title')}</p>
          <h2 class="h-2">{t(locale, 'about.team.title')}</h2>
          <p class="lead">{t(locale, 'about.team.body')}</p>
          <div class="stats">
            <div class="stat">
              <span class="stat__num" data-counter="12" data-counter-duration="1400">12</span>
              <span class="stat__label">{locale === 'es' ? 'nacionalidades' : 'nationalities'}</span>
            </div>
            <div class="stat">
              <span class="stat__num" data-counter="20" data-counter-suffix="+" data-counter-duration="1600">20+</span>
              <span class="stat__label">{locale === 'es' ? 'destinos' : 'destinations'}</span>
            </div>
            <div class="stat">
              <span class="stat__num" data-counter="15" data-counter-suffix="y" data-counter-duration="1400">15y</span>
              <span class="stat__label">{locale === 'es' ? 'de experiencia' : 'experience'}</span>
            </div>
            <div class="stat">
              <span class="stat__num" data-counter="500" data-counter-suffix="+" data-counter-duration="2200">500+</span>
              <span class="stat__label">{locale === 'es' ? 'mudanzas guiadas' : 'moves delivered'}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark grain">
    <div class="container">
      <div class="center-cta reveal reveal--scale">
        <h2 class="h-2">{t(locale, 'cta.headline')}</h2>
        <p class="lead">{t(locale, 'cta.subheadline')}</p>
        <a href={`/${locale}/contact`} class="btn btn--primary" data-magnetic="0.35">
          <span data-magnetic-inner>{t(locale, 'cta.button')}</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-mission {
    max-width: 880px;
    margin-inline: auto;
    text-align: center;
  }
  .about-mission .h-2 {
    color: var(--color-navy);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.4;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .value-card {
    background: var(--color-white);
    padding: 2.5rem 1.75rem;
    border-radius: var(--radius-md);
    border-top: 3px solid var(--color-gold);
    box-shadow: var(--shadow-sm);
  }
  .value-card__num {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--color-gold);
    font-weight: 500;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 1rem;
  }
  .value-card__title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
  }
  .value-card p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.5; }

  @media (max-width: 960px) { .values-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .values-grid { grid-template-columns: 1fr; } }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4rem;
    align-items: center;
  }
  .team-grid__media {
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: var(--shadow-md);
  }
  .team-grid__media img { width: 100%; height: 100%; object-fit: cover; }

  .stats {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(10, 29, 63, 0.1);
  }
  .stat { display: flex; flex-direction: column; gap: 0.4rem; }
  .stat__num {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--color-gold);
    line-height: 1;
    font-weight: 500;
  }
  .stat__label {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .center-cta { text-align: center; max-width: 640px; margin-inline: auto; }
  .center-cta .lead { margin: 1.25rem auto 2rem; }

  @media (max-width: 860px) {
    .team-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .stats { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  }
</style>