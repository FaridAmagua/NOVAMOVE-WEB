---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t, localeParams, type Locale } from '../../utils/i18n';

const locale = Astro.params.locale as Locale;
export async function getStaticPaths() {
  return localeParams;
}
---

<BaseLayout
  title={t(locale, 'nav.contact')}
  transparentHeader={true}
>
  <PageHero
    eyebrow={t(locale, 'contact.title')}
    title={t(locale, 'contact.title')}
    subtitle={t(locale, 'contact.subtitle')}
    image="https://images.unsplash.com/photo-1568992687947-868a62a9f521?w=2000&q=80"
    align="center"
  />

  <section class="section">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-8 lg:gap-16 items-start">
        <!-- Contact form -->
        <form class="contact-form reveal bg-white p-6 md:p-10 border border-navy/5 rounded-lg shadow-sm" novalidate data-loading-on-submit>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="flex flex-col gap-1.5">
              <label for="name" class="text-xs font-semibold tracking-[0.1em] uppercase text-navy">{t(locale, 'contact.form.name')}</label>
              <input class="input" type="text" id="name" name="name" required autocomplete="name" />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="email" class="text-xs font-semibold tracking-[0.1em] uppercase text-navy">{t(locale, 'contact.form.email')}</label>
              <input class="input" type="email" id="email" name="email" required autocomplete="email" />
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-5">
            <div class="flex flex-col gap-1.5">
              <label for="phone" class="text-xs font-semibold tracking-[0.1em] uppercase text-navy">{t(locale, 'contact.form.phone')}</label>
              <input class="input" type="tel" id="phone" name="phone" autocomplete="tel" />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="origin" class="text-xs font-semibold tracking-[0.1em] uppercase text-navy">{t(locale, 'contact.form.origin')}</label>
              <input class="input" type="text" id="origin" name="origin" />
            </div>
          </div>
          <div class="flex flex-col gap-1.5 mt-5">
            <label for="destination" class="text-xs font-semibold tracking-[0.1em] uppercase text-navy">{t(locale, 'contact.form.destination')}</label>
            <input class="input" type="text" id="destination" name="destination" />
          </div>
          <div class="flex flex-col gap-1.5 mt-5">
            <label for="message" class="text-xs font-semibold tracking-[0.1em] uppercase text-navy">{t(locale, 'contact.form.message')}</label>
            <textarea class="textarea" id="message" name="message" required></textarea>
          </div>
          <p class="text-xs text-text-secondary my-4">{t(locale, 'contact.form.privacy')}</p>
          <button type="submit" class="btn btn--primary w-full">
            {t(locale, 'contact.form.submit')}
          </button>
        </form>

        <!-- Contact info -->
        <aside class="contact-info reveal bg-navy text-white p-6 md:p-10 rounded-lg">
          <h2 class="h3 text-white mb-8">{t(locale, 'contact.info.title')}</h2>

          <div class="py-5 border-b border-white/10 flex flex-col gap-1.5 last:border-b-0">
            <span class="text-xs font-semibold tracking-[0.18em] uppercase text-gold">Email</span>
            <a href="mailto:hello@globalmove.com" class="text-white text-lg leading-relaxed hover:text-gold-soft transition-colors">hello@globalmove.com</a>
          </div>

          <div class="py-5 border-b border-white/10 flex flex-col gap-1.5 last:border-b-0">
            <span class="text-xs font-semibold tracking-[0.18em] uppercase text-gold">{locale === 'es' ? 'Teléfono' : 'Phone'}</span>
            <a href="tel:+34600123456" class="text-white text-lg leading-relaxed hover:text-gold-soft transition-colors">+34 600 123 456</a>
          </div>

          <div class="py-5 border-b border-white/10 flex flex-col gap-1.5 last:border-b-0">
            <span class="text-xs font-semibold tracking-[0.18em] uppercase text-gold">{locale === 'es' ? 'Oficinas' : 'Offices'}</span>
            <span class="text-white text-lg leading-relaxed whitespace-pre-line">{t(locale, 'contact.info.address')}</span>
          </div>

          <div class="py-5 border-b border-white/10 flex flex-col gap-1.5 last:border-b-0">
            <span class="text-xs font-semibold tracking-[0.18em] uppercase text-gold">{locale === 'es' ? 'Horario' : 'Hours'}</span>
            <span class="text-white/85 text-base leading-relaxed whitespace-pre-line">
              {locale === 'es'
                ? 'Lunes a Viernes · 9:00 – 19:00\nConcierge 24/7'
                : 'Monday to Friday · 9:00 – 19:00\nConcierge 24/7'}
            </span>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Form banner (used by JS to show success message) */
  .form-banner {
    padding: 0.95rem 1.25rem;
    border-radius: var(--radius-md);
    font-size: 0.92rem;
    margin-bottom: 1.5rem;
    border: 1px solid transparent;
    animation: bannerIn 320ms var(--ease-out);
  }
  .form-banner--success {
    background: rgba(34, 87, 46, 0.08);
    color: #1d5230;
    border-color: rgba(34, 87, 46, 0.25);
  }
  .form-banner--error {
    background: rgba(185, 69, 69, 0.08);
    color: #8a2929;
    border-color: rgba(185, 69, 69, 0.25);
  }
  @keyframes bannerIn {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: none; }
  }
</style>

<script>
  const form = document.querySelector('.contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    if (!btn) return;
    const original = btn.textContent ?? '';
    btn.classList.add('is-loading');
    btn.setAttribute('aria-busy', 'true');

    showBanner(form, 'success', document.documentElement.lang === 'es'
      ? '✓ Mensaje enviado. Te contactaremos en menos de 24 horas.'
      : '✓ Message sent. We\'ll get back to you within 24 hours.');

    setTimeout(() => {
      btn.classList.remove('is-loading');
      btn.removeAttribute('aria-busy');
      form.reset();
    }, 2400);
  });

  function showBanner(form: HTMLFormElement, type: 'success' | 'error', message: string) {
    let banner = form.parentElement?.querySelector<HTMLElement>('.form-banner');
    if (!banner) {
      banner = document.createElement('div');
      banner.className = 'form-banner';
      form.prepend(banner);
    }
    banner.className = `form-banner form-banner--${type}`;
    banner.textContent = message;
    banner.setAttribute('role', type === 'error' ? 'alert' : 'status');
    setTimeout(() => banner?.remove(), 6000);
  }
</script>
