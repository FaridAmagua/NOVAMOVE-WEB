---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t, supportedLocales, type Locale } from '../../utils/i18n';

const locale = Astro.params.locale as Locale;
export async function getStaticPaths() {
  return supportedLocales.map(locale => ({ params: { locale } }));
}
---

<BaseLayout
  title={t(locale, 'nav.contact')}
  transparentHeader={true}
>
  <PageHero
    title={t(locale, 'contact.title')}
    subtitle={t(locale, 'contact.subtitle')}
    image="https://images.unsplash.com/photo-1568992687947-868a62a9f521?w=2000&q=80"
    align="center"
  />

  <section class="section contact-page">
    <div class="container contact-page__inner">
      <div class="contact-page__layout">
        <form class="contact-form reveal" novalidate data-loading-on-submit>
          <div class="contact-form__grid">
            <div class="contact-form__field">
              <label for="name">{t(locale, 'contact.form.name')}</label>
              <input class="input" type="text" id="name" name="name" required autocomplete="name" />
            </div>
            <div class="contact-form__field">
              <label for="email">{t(locale, 'contact.form.email')}</label>
              <input class="input" type="email" id="email" name="email" required autocomplete="email" />
            </div>
          </div>

          <div class="contact-form__grid">
            <div class="contact-form__field">
              <label for="phone">{t(locale, 'contact.form.phone')}</label>
              <input class="input" type="tel" id="phone" name="phone" autocomplete="tel" />
            </div>
            <div class="contact-form__field">
              <label for="origin">{t(locale, 'contact.form.origin')}</label>
              <input class="input" type="text" id="origin" name="origin" />
            </div>
          </div>

          <div class="contact-form__field">
            <label for="destination">{t(locale, 'contact.form.destination')}</label>
            <input class="input" type="text" id="destination" name="destination" />
          </div>

          <div class="contact-form__field">
            <label for="message">{t(locale, 'contact.form.message')}</label>
            <textarea class="textarea" id="message" name="message" required></textarea>
          </div>

          <p class="contact-form__privacy">{t(locale, 'contact.form.privacy')}</p>
          <button type="submit" class="btn btn--primary contact-form__submit">
            {t(locale, 'contact.form.submit')}
          </button>
        </form>

        <aside class="contact-info reveal">
          <h2>{t(locale, 'contact.info.title')}</h2>

          <div class="contact-info__item">
            <span>Email</span>
            <a href="mailto:hello@globalmove.com">hello@globalmove.com</a>
          </div>

          <div class="contact-info__item">
            <span>{locale === 'es' ? 'Teléfono' : 'Phone'}</span>
            <a href="tel:+34600123456">+34 600 123 456</a>
          </div>

          <div class="contact-info__item">
            <span>{locale === 'es' ? 'Oficinas' : 'Offices'}</span>
            <strong>{t(locale, 'contact.info.address')}</strong>
          </div>

          <div class="contact-info__item">
            <span>{locale === 'es' ? 'Horario' : 'Hours'}</span>
            <strong>
              {locale === 'es'
                ? 'Lunes a Viernes · 9:00 - 19:00\nConcierge 24/7'
                : 'Monday to Friday · 9:00 - 19:00\nConcierge 24/7'}
            </strong>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    background: #f7f7f7;
  }

  .contact-page__inner {
    max-width: 1180px;
  }

  .contact-page__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(320px, 0.8fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  .contact-form,
  .contact-info {
    border-radius: 8px;
  }

  .contact-form {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.35rem, 3vw, 2.5rem);
    border: 1px solid rgba(0, 26, 114, 0.08);
    background: #fff;
    box-shadow: 0 18px 44px rgba(0, 26, 114, 0.06);
  }

  .contact-form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .contact-form__field {
    display: grid;
    gap: 0.45rem;
  }

  .contact-form label {
    color: #001a72;
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 12px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-form .input,
  .contact-form .textarea {
    min-height: 48px;
    border-color: rgba(0, 26, 114, 0.14);
    border-radius: 8px;
    background: #fff;
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 14px;
    font-weight: 500;
  }

  .contact-form .textarea {
    min-height: 150px;
  }

  .contact-form__privacy {
    margin: 0;
    color: rgba(0, 0, 0, 0.62);
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 12px;
    line-height: 1.55;
    font-weight: 500;
  }

  .contact-form__submit {
    width: 100%;
    min-height: 54px;
    border-radius: 999px;
  }

  .contact-info {
    padding: clamp(1.35rem, 3vw, 2.25rem);
    background: #001a72;
    color: #fff;
  }

  .contact-info h2 {
    margin: 0 0 1.35rem;
    color: #fff;
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 23px;
    line-height: 1.12;
    font-weight: 900;
  }

  .contact-info__item {
    display: grid;
    gap: 0.42rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .contact-info__item:last-child {
    border-bottom: 0;
  }

  .contact-info__item span {
    color: rgba(255, 255, 255, 0.62);
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 12px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-info__item a,
  .contact-info__item strong {
    color: #fff;
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.45;
    white-space: pre-line;
    text-decoration: none;
  }

  .contact-info__item a:hover {
    color: #d9b76f;
  }

  .form-banner {
    padding: 0.95rem 1.25rem;
    border-radius: var(--radius-md);
    font-size: 0.92rem;
    margin-bottom: 0.25rem;
    border: 1px solid transparent;
    animation: bannerIn 320ms var(--ease-out);
  }

  .form-banner--success {
    background: rgba(34, 87, 46, 0.08);
    color: #1d5230;
    border-color: rgba(34, 87, 46, 0.25);
  }

  .form-banner--error {
    background: rgba(185, 69, 69, 0.08);
    color: #8a2929;
    border-color: rgba(185, 69, 69, 0.25);
  }

  @keyframes bannerIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 860px) {
    .contact-page__layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .contact-form__grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .contact-form,
    .contact-info {
      padding: 1.25rem;
    }
  }
</style>

<script>
  const form = document.querySelector('.contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    if (!btn) return;
    btn.classList.add('is-loading');
    btn.setAttribute('aria-busy', 'true');

    showBanner(form, 'success', document.documentElement.lang === 'es'
      ? '✓ Mensaje enviado. Te contactaremos en menos de 24 horas.'
      : '✓ Message sent. We will get back to you within 24 hours.');

    setTimeout(() => {
      btn.classList.remove('is-loading');
      btn.removeAttribute('aria-busy');
      form.reset();
    }, 2400);
  });

  function showBanner(form: HTMLFormElement, type: 'success' | 'error', message: string) {
    let banner = form.querySelector<HTMLElement>('.form-banner');
    if (!banner) {
      banner = document.createElement('div');
      banner.className = 'form-banner';
      form.prepend(banner);
    }
    banner.className = `form-banner form-banner--${type}`;
    banner.textContent = message;
    banner.setAttribute('role', type === 'error' ? 'alert' : 'status');
    setTimeout(() => banner?.remove(), 6000);
  }
</script>
