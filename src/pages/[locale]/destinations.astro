---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t, localeParams, type Locale } from '../../utils/i18n';

const locale = Astro.params.locale as Locale;

const destinations = [
  {
    key: 'madrid', img: 'https://images.unsplash.com/photo-1543783207-ec64e4d95325?w=1400&q=80',
    desc: {
      es: 'Barrio de Salamanca, Chamberí, Retiro. El corazón financiero y cultural de España, con la mejor oferta gastronómica y educativa del país.',
      en: 'Salamanca, Chamberí, Retiro. Spain\'s financial and cultural heart, with the country\'s top gastronomy and education.',
    },
  },
  {
    key: 'barcelona', img: 'https://images.unsplash.com/photo-1583422409516-2895a77efded?w=1400&q=80',
    desc: {
      es: 'Eixample, Pedralbes, Barceloneta. Arquitectura modernista, mar Mediterráneo y un ecosistema de startups y creatividad único en el sur de Europa.',
      en: 'Eixample, Pedralbes, Barceloneta. Modernista architecture, Mediterranean sea, and southern Europe\'s most vibrant startup scene.',
    },
  },
  {
    key: 'marbella', img: 'https://images.unsplash.com/photo-1513519245088-0e12902e5a38?w=1400&q=80',
    desc: {
      es: 'Milla de Oro, La Zagaleta, Puerto Banús. Lujo discreto, los mejores campos de golf de Europa, gastronomía Michelin y seguridad premium.',
      en: 'Golden Mile, La Zagaleta, Puerto Banús. Discreet luxury, Europe\'s best golf courses, Michelin dining and premium safety.',
    },
  },
  {
    key: 'mallorca', img: 'https://images.unsplash.com/photo-1599809275671-b5942cabc7a2?w=1400&q=80',
    desc: {
      es: 'Pollensa, Alcúdia, Son Vida. Naturaleza protegida, fincas centenarias y la combinación perfecta entre privacidad, mar y tradición.',
      en: 'Pollensa, Alcúdia, Son Vida. Protected nature, centenary estates and the perfect blend of privacy, sea and tradition.',
    },
  },
  {
    key: 'ibiza', img: 'https://images.unsplash.com/photo-1559656914-a30970c1affd?w=1400&q=80',
    desc: {
      es: 'San José, Santa Eulària, Sant Joan. Reserva de la Biosfera UNESCO, las fincas más exclusivas del Mediterráneo y un lifestyle único.',
      en: 'San José, Santa Eulària, Sant Joan. UNESCO Biosphere Reserve, the Mediterranean\'s most exclusive fincas and a unique lifestyle.',
    },
  },
  {
    key: 'canarias', img: 'https://images.unsplash.com/photo-1505939435612-a18ea96b80b3?w=1400&q=80',
    desc: {
      es: 'Tenerife, Gran Canaria, Lanzarote. Clima subtropical todo el año, las ventajas fiscales del REF canario y acceso aéreo a Europa y África.',
      en: 'Tenerife, Gran Canaria, Lanzarote. Year-round subtropical climate, Canary REF tax advantages and air access to Europe and Africa.',
    },
  },
];
export async function getStaticPaths() {
  return localeParams;
}
---

<BaseLayout
  title={t(locale, 'nav.destinations')}
  transparentHeader={true}
>
  <PageHero
    eyebrow={t(locale, 'destinations.eyebrow')}
    title={t(locale, 'destinations.headline')}
    subtitle={t(locale, 'destinations.subheadline')}
    image="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=2000&q=80"
  />

  <section class="section">
    <div class="container">
      <div class="flex flex-col gap-16 md:gap-24">
        {destinations.map(({ key, img, desc }, i) => (
          <article id={key}
            class={`reveal grid grid-cols-1 md:grid-cols-[1.1fr_1fr] gap-8 md:gap-16 items-center ${i % 2 === 1 ? 'md:[direction:rtl]' : ''}`}>
            <div class="[direction:ltr] rounded-lg overflow-hidden aspect-[4/3] shadow-md">
              <img src={img} alt="" loading="lazy" class="w-full h-full object-cover" />
            </div>
            <div class="[direction:ltr]">
              <span class="eyebrow">0{i + 1}</span>
              <h2 class="h2 mb-4">{t(locale, `destinations.items.${key}.name`)}</h2>
              <p class="lead mb-5">{t(locale, `destinations.items.${key}.tag`)}</p>
              <p>{desc[locale]}</p>
              <a href={`/${locale}/contact`} class="btn btn--link mt-4">{t(locale, 'common.bookViewing')}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="reveal text-center max-w-2xl mx-auto">
        <h2 class="h2">{t(locale, 'cta.headline')}</h2>
        <p class="lead mx-auto my-5">{t(locale, 'cta.subheadline')}</p>
        <a href={`/${locale}/contact`} class="btn btn--primary">{t(locale, 'cta.button')}</a>
      </div>
    </div>
  </section>
</BaseLayout>
