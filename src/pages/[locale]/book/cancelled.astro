---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t, localeParams, type Locale } from '../../../utils/i18n';
import { getPropertyBySlug } from '../../../data/properties';

export async function getStaticPaths() {
  return localeParams;
}

const locale = Astro.params.locale as Locale;
const propertySlug = Astro.url.searchParams.get('prop') ?? '';
const property = propertySlug ? getPropertyBySlug(propertySlug) : undefined;
---

<BaseLayout
  title={t(locale, 'bookingCancelled.title')}
  description={t(locale, 'bookingCancelled.subtitle')}
  transparentHeader={false}
>
  <section class="pt-[calc(var(--header-height)+4rem)] pb-24 bg-cream min-h-[80vh]">
    <div class="container">
      <div class="reveal text-center max-w-2xl mx-auto">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-charcoal text-white rounded-full mb-8" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-11 h-11">
            <circle cx="12" cy="12" r="11"/>
            <path d="M8 8l8 8M16 8l-8 8"/>
          </svg>
        </div>

        <p class="eyebrow">{t(locale, 'bookingCancelled.subtitle')}</p>
        <h1 class="h-1 mb-4">{t(locale, 'bookingCancelled.title')}</h1>
        <p class="lead mx-auto">{t(locale, 'bookingCancelled.message')}</p>

        <div class="flex flex-wrap justify-center gap-4 mt-10">
          {property && (
            <a href={`/${locale}/properties/${property.slug}`} class="btn btn--primary">
              {t(locale, 'bookingCancelled.tryAgain')}
            </a>
          )}
          <a href={`/${locale}/properties`} class="btn btn--secondary">
            {t(locale, 'nav.properties')}
          </a>
        </div>

        <p class="mt-8 text-sm text-text-secondary">{t(locale, 'bookingCancelled.help')}</p>
      </div>
    </div>
  </section>
</BaseLayout>
