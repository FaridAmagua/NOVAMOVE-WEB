---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t, localeParams, type Locale } from '../../../utils/i18n';
import { getPropertyBySlug } from '../../../data/properties';

export async function getStaticPaths() {
  return localeParams;
}

const locale = Astro.params.locale as Locale;
const orderRef = Astro.url.searchParams.get('ref') ?? '';
const propertySlug = Astro.url.searchParams.get('prop') ?? '';
const isDev = Astro.url.searchParams.get('dev') === '1';

const property = propertySlug ? getPropertyBySlug(propertySlug) : undefined;

const steps = ['step1Title', 'step2Title', 'step3Title'] as const;
const stepDescs = ['step1Desc', 'step2Desc', 'step3Desc'] as const;
---

<BaseLayout
  title={t(locale, 'bookingSuccess.title')}
  description={t(locale, 'bookingSuccess.subtitle')}
  transparentHeader={false}
>
  <section class="pt-[calc(var(--header-height)+4rem)] pb-24 bg-cream min-h-screen">
    <div class="container">
      <!-- Inner confirmation block -->
      <div class="reveal text-center max-w-2xl mx-auto mb-20">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-gold text-navy rounded-full mb-8" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-11 h-11">
            <circle cx="12" cy="12" r="11"/>
            <path d="M7 12l3 3 7-7"/>
          </svg>
        </div>

        <p class="eyebrow">{t(locale, 'bookingSuccess.thanks')}</p>
        <h1 class="h-1 mb-4">{t(locale, 'bookingSuccess.title')}</h1>
        <p class="lead mx-auto">{t(locale, 'bookingSuccess.message')}</p>

        {orderRef && (
          <div class="inline-flex flex-col items-center gap-2 my-10 px-8 py-5 bg-white border border-navy/10 rounded-lg">
            <span class="text-xs text-gold tracking-[0.16em] uppercase font-semibold">
              {t(locale, 'bookingSuccess.reference')}
            </span>
            <span class="font-serif text-2xl text-navy tracking-[0.1em]">{orderRef}</span>
            {isDev && <span class="text-xs text-red-700 font-semibold tracking-[0.18em] uppercase">DEV MODE</span>}
          </div>
        )}

        <div class="flex flex-wrap justify-center gap-6 mt-8">
          <a href={`/${locale}/`} class="btn btn--secondary">{t(locale, 'bookingSuccess.backHome')}</a>
          {property && (
            <a href={`/${locale}/properties/${property.slug}`} class="btn btn--link">
              {t(locale, 'bookingSuccess.viewProperty')} →
            </a>
          )}
        </div>
      </div>

      <!-- Next steps block -->
      <div class="reveal max-w-4xl mx-auto">
        <h2 class="h-2 text-center mb-12">{t(locale, 'bookingSuccess.nextSteps')}</h2>
        <ol class="flex flex-col gap-6">
          {steps.map((step, i) => (
            <li class="flex gap-6 p-8 bg-white rounded-lg border-l-4 border-gold">
              <span class="font-serif text-3xl text-gold font-medium leading-none flex-shrink-0">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="font-serif text-xl text-navy font-semibold mb-2">{t(locale, `bookingSuccess.${step}`)}</h3>
                <p class="text-text-secondary leading-relaxed m-0">{t(locale, `bookingSuccess.${stepDescs[i]}`)}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>
