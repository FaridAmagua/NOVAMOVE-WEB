---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t, localeParams, type Locale } from '../../../utils/i18n';
import { getProperties, zoneLabel, type Property } from '../../../data/property-source';
import { propertyTypeLabel, formatPrice } from '../../../data/properties';

export async function getStaticPaths() {
  const { properties } = await getProperties();
  // Solo propiedades en alquiler (larga duración)
  const paths: Array<{ params: { locale: string; slug: string }; props: { property: Property } }> = [];
  for (const { params: { locale } } of localeParams) {
    for (const p of properties.filter((x) => x.transaction === 'rent')) {
      paths.push({ params: { locale, slug: p.slug }, props: { property: p } });
    }
  }
  return paths;
}

const { property } = Astro.props as { property: Property };
const locale = Astro.params.locale as Locale;
const propertyUrl = `/${locale}/properties/${property.slug}`;
const inquirySubject = encodeURIComponent(
  locale === 'es'
    ? `Solicitud de información: ${property.name.es}`
    : `Information request: ${property.name.en}`
);
---

<BaseLayout
  title={`${t(locale, 'properties.requestInfo')} — ${property.name[locale]}`}
  description={property.tagline[locale]}
  transparentHeader={false}
>
  <section class="section">
    <div class="container">
      <a href={propertyUrl}
         class="inline-block text-xs tracking-[0.14em] uppercase text-gold mb-8 border-b border-current pb-0.5 hover:text-navy transition-colors">
        ← {property.name[locale]}
      </a>

      <header class="reveal max-w-2xl mb-12">
        <p class="eyebrow">{t(locale, 'properties.requestInfo')}</p>
        <h1 class="h-1">{property.name[locale]}</h1>
        <p class="lead">{property.tagline[locale]}</p>
        <p class="mt-6 text-text-secondary">
          {locale === 'es'
            ? 'Esta propiedad está disponible para alquiler de larga duración. Envíanos una solicitud y un advisor te contactará en menos de 24 horas con disponibilidad, condiciones exactas y opciones de personalización.'
            : 'This property is available for long-term rental. Send us a request and an advisor will contact you within 24 hours with availability, exact terms and customisation options.'}
        </p>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-8 lg:gap-12 items-start">
        <div class="reveal bg-white border border-navy/10 rounded-lg p-6 md:p-8">
          <a
            href={`/${locale}/contact?subject=${inquirySubject}&property=${property.slug}`}
            class="btn btn--primary w-full text-base"
            data-magnetic="0.25"
          >
            <span data-magnetic-inner>{t(locale, 'properties.requestInfo')}</span>
          </a>
          <a
            href={`/${locale}/contact?subject=${inquirySubject}&visit=1&property=${property.slug}`}
            class="mt-3 block text-center text-[0.85rem] tracking-[0.14em] uppercase text-gold border border-gold/40 rounded px-4 py-3 hover:bg-gold hover:text-navy transition-colors"
          >
            {locale === 'es' ? 'Concertar visita' : 'Schedule a viewing'}
          </a>
          <p class="text-xs text-text-secondary mt-4 text-center">
            {locale === 'es'
              ? 'Sin compromiso · Respuesta en <24h · Asesor personal'
              : 'No commitment · Reply in <24h · Personal advisor'}
          </p>
        </div>

        <aside class="lg:sticky lg:top-[calc(var(--header-height)+2rem)]">
          <div class="reveal bg-white border border-navy/5 rounded-lg overflow-hidden shadow-md">
            <div class="aspect-[16/10] overflow-hidden">
              <img src={property.images[0]} alt={property.name[locale]} class="w-full h-full object-cover" />
            </div>
            <div class="p-7">
              <span class="text-[0.72rem] text-gold font-semibold tracking-[0.12em] uppercase">
                {propertyTypeLabel(property.type, locale)} · {zoneLabel(property.destination, locale)}
              </span>
              <h3 class="font-serif text-[1.35rem] text-navy mt-1.5 mb-0">{property.name[locale]}</h3>

              <div class="h-px bg-navy/5 my-5"></div>

              {(property.bedrooms || property.bathrooms || property.sizeM2) && (
                <div class="flex justify-between text-[0.92rem] text-text-primary mb-2.5">
                  {property.bedrooms && <span>{property.bedrooms} {t(locale, 'common.bedrooms')}</span>}
                  {property.bathrooms && <span>{property.bathrooms} {t(locale, 'common.bathrooms')}</span>}
                  {property.sizeM2 && <span>{property.sizeM2} m²</span>}
                </div>
              )}

              <div class="h-px bg-navy/5 my-5"></div>

              <div class="flex items-baseline gap-2 flex-wrap">
                <span class="text-[0.75rem] text-text-secondary uppercase tracking-[0.1em]">{t(locale, 'common.from')}</span>
                <span class="font-serif text-2xl text-gold font-medium">{formatPrice(property.price, locale)}</span>
                <span class="text-[0.82rem] text-text-secondary">/{locale === 'es' ? 'mes' : 'month'}</span>
              </div>
              <p class="text-[0.75rem] text-text-secondary mt-2">
                {locale === 'es'
                  ? '*Estancia mínima y gastos adicionales a confirmar con el advisor.'
                  : '*Minimum stay and additional fees to confirm with the advisor.'}
              </p>
            </div>
          </div>

          <div class="mt-6 text-center text-[0.82rem] text-text-secondary">
            🔒 {locale === 'es'
              ? 'Tus datos solo se usan para esta consulta · Sin compromiso'
              : 'Your data is only used for this inquiry · No commitment'}
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
