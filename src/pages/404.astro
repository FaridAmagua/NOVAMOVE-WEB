---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { localizedPath, type Locale } from '../utils/i18n';

// Detect locale from the URL (static fallback to Spanish).
const locale: Locale = 'es';

// Quick-escape pages
const escapeRoutes = [
  { href: localizedPath(locale, '/'), label: locale === 'es' ? 'Inicio' : 'Home', desc: locale === 'es' ? 'Volver a empezar' : 'Start over' },
  { href: localizedPath(locale, '/properties'), label: locale === 'es' ? 'Propiedades' : 'Properties', desc: locale === 'es' ? 'Explorar villas y apartamentos' : 'Browse villas & apartments' },
  { href: localizedPath(locale, '/services'), label: locale === 'es' ? 'Servicios' : 'Services', desc: locale === 'es' ? 'Relocation, rentals, concierge' : 'Relocation, rentals, concierge' },
  { href: localizedPath(locale, '/blog'), label: 'Blog', desc: locale === 'es' ? 'Guías y actualidad' : 'Guides & insights' },
  { href: localizedPath(locale, '/contact'), label: locale === 'es' ? 'Contacto' : 'Contact', desc: locale === 'es' ? 'Hablar con un advisor' : 'Talk to an advisor' },
];
---

<BaseLayout
  title="404 · Página no encontrada"
  description="La página que buscas se ha mudado o no existe."
  transparentHeader={true}
  hideHeader={true}
  hideFooter={true}
>
  <main class="relative min-h-screen flex items-stretch text-white overflow-hidden">
    <!-- Background image + overlay -->
    <div class="absolute inset-0 -z-0" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1505691938895-1758d7feb511?w=2000&q=80"
        alt=""
        data-ken-burns
        class="w-full h-full object-cover opacity-45"
      />
      <div class="absolute inset-0"
        style="background:
          radial-gradient(ellipse at 30% 30%, rgba(10,29,63,0.4) 0%, rgba(10,29,63,0.85) 70%),
          linear-gradient(180deg, rgba(10,29,63,0.3) 0%, rgba(10,29,63,0.85) 100%);"
      ></div>
    </div>

    <div class="container relative pt-[calc(var(--header-height)+2rem)] sm:pt-[calc(var(--header-height)+3rem)] pb-16 flex flex-col gap-8 w-full min-h-[80vh]">
      <!-- Brand top -->
      <div class="reveal pt-4">
        <Logo locale={locale} variant="white" withWordmark={true} size={48} />
      </div>

      <!-- Main content -->
      <div class="max-w-3xl mt-8">
        <p class="eyebrow eyebrow--light reveal reveal--blur">
          {locale === 'es' ? 'Error 404 · Página no encontrada' : 'Error 404 · Page not found'}
        </p>

        <h1
          class="reveal font-serif font-normal text-gold-soft leading-[0.85] tracking-tight mt-0 mb-4"
          style="font-size: clamp(8rem, 22vw, 18rem); text-shadow: 0 8px 60px rgba(200,167,106,0.25);"
          aria-hidden="true"
        >404</h1>

        <h2
          class="reveal font-serif font-medium text-white text-[clamp(1.5rem,3vw,2.25rem)] leading-tight mb-5"
          style="--reveal-delay: 200ms;"
        >
          {locale === 'es' ? (
            <>Esta dirección <span class="italic-serif">se ha mudado</span><br/>o nunca existió.</>
          ) : (
            <>This address <span class="italic-serif">has moved</span><br/>or never existed.</>
          )}
        </h2>

        <p
          class="reveal text-white/80 text-base sm:text-lg leading-relaxed max-w-[56ch] mb-10"
          style="--reveal-delay: 320ms;"
        >
          {locale === 'es'
            ? 'A veces las cosas cambian de sitio durante un relocation. Aquí tienes algunos atajos para volver al buen camino.'
            : 'Sometimes things move during a relocation. Here are some shortcuts to get you back on track.'}
        </p>

        <div class="reveal flex flex-wrap gap-4" style="--reveal-delay: 440ms;">
          <a href={localizedPath(locale, '/')} class="btn btn--primary" data-magnetic="0.3">
            <span data-magnetic-inner>{locale === 'es' ? 'Volver al inicio' : 'Back home'}</span>
          </a>
          <a href={localizedPath(locale, '/contact')} class="btn btn--ghost" data-magnetic="0.3">
            <span data-magnetic-inner>{locale === 'es' ? 'Pedir ayuda' : 'Get help'}</span>
          </a>
        </div>
      </div>

      <!-- Escape routes nav -->
      <nav
        class="reveal mt-12"
        style="--reveal-delay: 600ms;"
        aria-label={locale === 'es' ? 'Atajos' : 'Shortcuts'}
      >
        <p class="text-xs text-gold tracking-[0.18em] uppercase font-semibold mb-4">
          {locale === 'es' ? 'O explora:' : 'Or explore:'}
        </p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-2xl" data-stagger data-stagger-step="80">
          {escapeRoutes.slice(0, 4).map((r) => (
            <li class="reveal reveal--fade">
              <a
                href={r.href}
                class="escape-card group grid grid-cols-[1fr_auto] grid-rows-[auto_auto] gap-x-4 gap-y-1 items-center p-4 md:px-5 bg-white/[0.06] border border-white/10 rounded-lg text-white no-underline transition-all duration-300 hover:bg-white/[0.12] hover:border-gold hover:-translate-y-0.5"
                style="backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);"
              >
                <span class="font-serif text-[1.05rem] text-white">{r.label}</span>
                <span class="text-gold transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                <span class="col-span-2 text-xs text-white/60">{r.desc}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Bottom corner with logo + locale -->
      <div
        class="reveal reveal--fade flex flex-wrap justify-between items-center gap-4 pt-8 border-t border-white/10"
        style="--reveal-delay: 800ms;"
      >
        <Logo locale={locale} variant="white" withWordmark={false} size={28} />
        <p class="inline-flex items-center gap-2.5 text-xs font-semibold tracking-[0.12em] m-0">
          <a href="/es/" class="text-white/70 hover:opacity-100 hover:text-gold transition-opacity duration-300">ES</a>
          <span aria-hidden="true" class="text-white/40">/</span>
          <a href="/en/" class="text-white/70 hover:opacity-100 hover:text-gold transition-opacity duration-300">EN</a>
        </p>
      </div>
    </div>
  </main>
</BaseLayout>
