---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, localizedPath, type Locale } from '../utils/i18n';

interface Props {
  locale: Locale;
  currentPath: string;
  /** When true, header starts transparent over a dark hero, becomes solid on scroll */
  transparent?: boolean;
}

const { locale, currentPath, transparent = true } = Astro.props;

const navItems = [
  { key: 'nav.services', href: 'services' },
  { key: 'nav.destinations', href: 'destinations' },
  { key: 'nav.properties', href: 'properties' },
  { key: 'nav.about', href: 'about' },
  { key: 'nav.blog', href: 'blog' },
  { key: 'nav.contact', href: 'contact' },
].map(item => ({
  label: t(locale, item.key),
  href: localizedPath(locale, `/${item.href}`),
}));

const isActive = (href: string) => {
  const cleanCurrent = currentPath.replace(/\/$/, '');
  const cleanHref = href.replace(/\/$/, '');
  if (cleanHref.endsWith('/blog')) return cleanCurrent.startsWith(cleanHref);
  return cleanCurrent === cleanHref;
};

---

<header
  class={`site-header ${transparent ? 'site-header--transparent' : ''}`}
  data-transparent={transparent ? 'true' : 'false'}
>
  <div class="container site-header__inner">
    <!-- Wordmark image (GLOBAL.MOVE): navbar is either transparent (over hero)
         or navy glass (scrolled / non-transparent pages). The image is white-ish,
         designed for dark backgrounds. -->
    <a href={localizedPath(locale, '/')} class="site-header__wordmark" aria-label="Global Move — Inicio">
      <img src="/brand/wordmark-light.png" alt="GLOBAL.MOVE" width="894" height="100" />
      <span>GLOBAL.MOVE</span>
    </a>

    <nav class="site-nav" aria-label="Principal">
      <ul class="site-nav__list">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class={`site-nav__link ${isActive(item.href) ? 'is-active' : ''}`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <LanguageSwitcher locale={locale} currentPath={currentPath} variant={transparent ? 'light' : 'dark'} />
    </div>

    <div class="site-header__mobile-actions">
      <a class="site-header__icon-btn" href={localizedPath(locale, '/properties')} aria-label={locale === 'es' ? 'Buscar propiedades' : 'Search properties'}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>
      <button class="site-header__toggle" aria-label="Abrir menú" aria-expanded="false" data-menu-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="site-drawer" data-menu-drawer aria-hidden="true">
    <nav class="site-drawer__nav" aria-label="Móvil">
      <div class="site-drawer__top">
        <div class="site-drawer__lang">
          <LanguageSwitcher locale={locale} currentPath={currentPath} variant="light" />
        </div>
        <button class="site-drawer__close" type="button" aria-label="Cerrar menú" data-menu-close>
          <span></span>
          <span></span>
        </button>
      </div>
      <ul>
        {navItems.map(item => (
          <li>
            <a href={item.href} class="site-drawer__link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 16px;
    left: 0;
    right: 0;
    z-index: 100;
    padding-inline: clamp(0.75rem, 2vw, 1.5rem);
    pointer-events: none;
    transition: top var(--dur-base) var(--ease),
                color var(--dur-base) var(--ease),
                transform var(--dur-base) var(--ease);
  }

  .site-header.is-menu-open {
    z-index: 2147483000;
    pointer-events: auto;
  }

  .site-header--transparent {
    color: var(--color-white);
    background: transparent;
  }

  .site-header.is-scrolled,
  .site-header:not(.site-header--transparent) {
    color: var(--color-white);
  }

  /* When scrolled on dark navy, the active link underline stays white
     and the link opacity lifts to 1 for legibility */
  .site-header.is-scrolled .site-nav__link,
  .site-header:not(.site-header--transparent) .site-nav__link {
    opacity: 1;
  }

  .site-header.is-scrolled :global(.lang-switcher),
  .site-header:not(.site-header--transparent) :global(.lang-switcher) {
    color: var(--color-white);
    border-color: rgba(255, 255, 255, 0.38);
  }

  .site-header.is-scrolled :global(.lang-switcher:hover),
  .site-header:not(.site-header--transparent) :global(.lang-switcher:hover) {
    background: var(--color-white);
    color: var(--color-navy);
    border-color: var(--color-white);
  }

  .site-header__inner {
    height: 72px;
    max-width: min(100%, 1520px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 2.5vw, var(--space-8));
    padding-inline: clamp(1.25rem, 2.6vw, 2.5rem);
    border: 1px solid transparent;
    border-radius: 999px;
    pointer-events: auto;
    transition: background var(--dur-base) var(--ease),
                box-shadow var(--dur-base) var(--ease),
                border-color var(--dur-base) var(--ease),
                backdrop-filter var(--dur-base) var(--ease);
  }

  .site-header.is-menu-open .site-header__inner {
    opacity: 0;
    pointer-events: none;
  }

  .site-header.is-scrolled .site-header__inner,
  .site-header:not(.site-header--transparent) .site-header__inner {
    background: rgba(10, 29, 63, 0.94);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: 0 16px 45px rgba(10, 29, 63, 0.22);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
  }

  .site-header__wordmark {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity var(--dur-base) var(--ease);
  }
  .site-header__wordmark img {
    display: block;
    height: 50px;
    width: auto;
  }
  .site-header__wordmark span {
    display: none;
    color: var(--color-white);
    font-family: var(--font-sans);
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
  }
  .site-header__wordmark:hover { opacity: 0.85; }

  @media (max-width: 960px) {
    .site-header__wordmark img {
      height: 28px;
    }
  }

  @media (max-width: 720px) {
    .site-header__wordmark img {
      height: 18px;
    }
  }

  .site-nav__list {
    display: flex;
    gap: clamp(1.1rem, 2vw, var(--space-8));
    align-items: center;
  }

  .site-nav__link {
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0;
    padding: 0.4rem 0;
    position: relative;
    opacity: 0.94;
    transition: opacity var(--dur-base) var(--ease);
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width var(--dur-base) var(--ease);
  }

  .site-nav__link:hover,
  .site-nav__link.is-active {
    opacity: 1;
  }

  .site-nav__link:hover::after,
  .site-nav__link.is-active::after {
    width: 100%;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-header__cta { padding: 0.85rem 1.25rem; font-size: 0.72rem; min-height: 44px; }

  .site-header__mobile-actions {
    display: none;
    align-items: center;
    gap: 0.66rem;
    flex-shrink: 0;
  }

  .site-header__icon-btn {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 50%;
    color: var(--color-white);
    transition: background var(--dur-base) var(--ease), border-color var(--dur-base) var(--ease), transform var(--dur-base) var(--ease);
  }

  .site-header__icon-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.42);
    transform: translateY(-1px);
  }

  .site-header__icon-btn svg {
    width: 21px;
    height: 21px;
  }

  .site-header__toggle {
    display: none;
    width: 44px;
    height: 44px;
    padding: 0;
    z-index: 310;
    border-radius: 4px;
    position: relative;
  }
  /* Use absolute positioning so the 3 bars are always evenly spaced
     regardless of flex/justify-content quirks */
  .site-header__toggle span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 24px;
    height: 2px;
    margin-left: -12px;
    background: currentColor;
    border-radius: 1px;
    transform: translateY(-50%);
    transition: transform var(--dur-base) var(--ease), opacity var(--dur-base) var(--ease);
  }
  .site-header__toggle span:nth-child(1) { transform: translate(-12px, -10px); }
  .site-header__toggle span:nth-child(2) { transform: translate(-12px, -50%); }
  .site-header__toggle span:nth-child(3) { transform: translate(-12px, 10px); }

  .site-header__toggle.is-open span:nth-child(1) { transform: translate(-12px, -50%) rotate(45deg); }
  .site-header__toggle.is-open span:nth-child(2) { opacity: 0; }
  .site-header__toggle.is-open span:nth-child(3) { transform: translate(-12px, -50%) rotate(-45deg); }

  .site-header__toggle.is-open {
    opacity: 0;
    pointer-events: none;
  }

  .site-drawer {
    position: fixed;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(10, 29, 63, 0.995) 0%, rgba(6, 17, 41, 0.998) 100%);
    color: var(--color-white);
    transform: translateX(100%);
    transition: transform var(--dur-slow) var(--ease);
    padding: 1.5rem 1.5rem 2rem;
    /* Above header so links are clickable when open. */
    z-index: 2147483001;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .site-drawer.is-open { transform: translateX(0); }

  .site-drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(2rem, 7vh, 3.5rem);
  }

  .site-drawer__close {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 50%;
    color: var(--color-white);
    position: relative;
    flex: 0 0 auto;
    z-index: 2;
    pointer-events: auto;
  }

  .site-drawer__close span {
    position: absolute;
    width: 20px;
    height: 2px;
    background: currentColor;
    border-radius: 999px;
  }

  .site-drawer__close span:first-child { transform: rotate(45deg); }
  .site-drawer__close span:last-child { transform: rotate(-45deg); }

  .site-drawer__nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 2.5rem;
  }
  .site-drawer__link {
    display: flex;
    align-items: center;
    min-height: 54px;
    padding: 0.7rem 0;
    font-family: var(--font-sans);
    font-size: clamp(1.55rem, 7vw, 2.1rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0;
    color: var(--color-white);
  }
  .site-drawer__lang {
    display: inline-flex;
  }

  @media (max-width: 960px) {
    .site-nav, .site-header__actions { display: none; }
    .site-header__mobile-actions { display: flex; }
    .site-header__toggle { display: flex; }
    .site-header__inner { position: relative; z-index: 300; height: 72px; }
    .site-header { color: var(--color-white); }
  }

  @media (max-width: 720px) {
    .site-header {
      top: 14px;
      padding-inline: clamp(0.8rem, 3.2vw, 1.4rem);
    }

    .site-header__inner {
      width: min(100%, 420px);
      height: 86px;
      margin-inline: auto;
      padding-inline: clamp(1.3rem, 4.4vw, 1.72rem);
      border-radius: 999px;
      background: transparent;
      border-color: transparent;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .site-header.is-scrolled .site-header__inner,
    .site-header:not(.site-header--transparent) .site-header__inner {
      background: rgba(0, 26, 114, 0.92);
      border-color: rgba(255, 255, 255, 0.16);
      box-shadow: 0 18px 46px rgba(0, 26, 114, 0.26);
      backdrop-filter: blur(12px) saturate(130%);
      -webkit-backdrop-filter: blur(12px) saturate(130%);
    }

    .site-header__wordmark img {
      display: none;
    }

    .site-header__wordmark span {
      display: block;
      font-size: clamp(1.34rem, 5.6vw, 1.62rem);
      transform: translateY(-0.02em);
    }

    .site-header__icon-btn {
      width: 42px;
      height: 42px;
      border-color: rgba(255, 255, 255, 0.24);
    }

    .site-header__icon-btn svg {
      width: 18px;
      height: 18px;
    }

    .site-header__toggle {
      width: 42px;
      height: 42px;
      border: 1px solid rgba(255, 255, 255, 0.24);
      border-radius: 50%;
    }

    .site-header__toggle span {
      width: 21px;
      height: 2.4px;
      margin-left: -10.5px;
      border-radius: 999px;
    }

    .site-header__toggle span:nth-child(1) { transform: translateY(-7px); }
    .site-header__toggle span:nth-child(2) { transform: translateY(-50%); }
    .site-header__toggle span:nth-child(3) { transform: translateY(7px); }

    .site-header__toggle.is-open span:nth-child(1) { transform: translateY(-50%) rotate(45deg); }
    .site-header__toggle.is-open span:nth-child(3) { transform: translateY(-50%) rotate(-45deg); }

    .site-drawer {
      padding-top: 1.25rem;
    }
  }
</style>

<script>
  // Mobile drawer toggle. Uses event delegation so it survives Astro View
  // Transitions (which replace the drawer element on each navigation).
  const closeDrawer = () => {
    document.querySelectorAll('.site-header.is-menu-open').forEach((el) => {
      el.classList.remove('is-menu-open');
    });
    document.querySelectorAll('.site-header__toggle.is-open, .site-drawer.is-open').forEach((el) => {
      el.classList.remove('is-open');
      if (el.classList.contains('site-header__toggle')) el.setAttribute('aria-expanded', 'false');
      if (el.classList.contains('site-drawer')) el.setAttribute('aria-hidden', 'true');
    });
    document.body.style.overflow = '';
  };

  const headerWindow = window as Window & { __globalMoveHeaderBoundVersion?: string };
  if (headerWindow.__globalMoveHeaderBoundVersion !== 'drawer-close-v4') {
    headerWindow.__globalMoveHeaderBoundVersion = 'drawer-close-v4';
    document.addEventListener('click', (e) => {
      const target = e.target instanceof Element ? e.target : null;
      if (!target) return;
      const toggle = target.closest('[data-menu-toggle]');
      const close = target.closest('[data-menu-close]');
      const drawer = target.closest('.site-drawer');

      if (close) {
        closeDrawer();
        return;
      }

      if (toggle) {
        const willBeOpen = toggle.getAttribute('aria-expanded') !== 'true';
        const headerEl = document.querySelector('.site-header');
        toggle.setAttribute('aria-expanded', String(willBeOpen));
        toggle.classList.toggle('is-open', willBeOpen);
        headerEl?.classList.toggle('is-menu-open', willBeOpen);
        const drawerEl = document.querySelector('.site-drawer');
        drawerEl?.classList.toggle('is-open', willBeOpen);
        drawerEl?.setAttribute('aria-hidden', String(!willBeOpen));
        document.body.style.overflow = willBeOpen ? 'hidden' : '';
        return;
      }

      if (drawer && target.closest('a')) closeDrawer();
    }, true);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDrawer();
    });
    document.addEventListener('astro:before-swap', closeDrawer);
  }
</script>
