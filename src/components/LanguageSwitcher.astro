---
import { languages, type Locale, swapLocaleInPath } from '../utils/i18n';

interface Props {
  locale: Locale;
  currentPath: string;
  variant?: 'dark' | 'light';
}

const { locale, currentPath, variant = 'light' } = Astro.props;
const localeOptions: Locale[] = ['es', 'en'];
---

<nav class={`lang-switcher lang-switcher--${variant}`} aria-label={locale === 'es' ? 'Seleccionar idioma' : 'Choose language'}>
  {localeOptions.map((option, index) => <>
    {index > 0 && <span class="lang-switcher__sep" aria-hidden="true">/</span>}
    <a
      href={option === locale ? currentPath : swapLocaleInPath(currentPath, option)}
      hreflang={option}
      lang={option}
      class:list={['lang-switcher__option', { 'is-active': option === locale }]}
      aria-current={option === locale ? 'page' : undefined}
      aria-label={`${languages[option]}${option === locale ? ' (actual)' : ''}`}
    >{option.toUpperCase()}</a>
  </>)}
</nav>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    padding: 0.28rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    transition: background var(--dur-base) var(--ease), color var(--dur-base) var(--ease);
  }
  .lang-switcher--light {
    color: var(--color-white);
    border-color: rgba(255, 255, 255, 0.4);
  }
  .lang-switcher--light:hover {
    border-color: rgba(255,255,255,.72);
  }
  .lang-switcher--dark {
    color: var(--color-navy);
    border-color: rgba(10, 29, 63, 0.25);
  }
  .lang-switcher--dark:hover {
    border-color: var(--color-navy);
  }
  .lang-switcher__option { min-width: 34px; min-height: 30px; padding: 0 .45rem; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; opacity: .68; transition: 160ms ease; }
  .lang-switcher__option:hover { opacity: 1; }
  .lang-switcher--light .lang-switcher__option.is-active { color: var(--color-navy); background: var(--color-white); opacity: 1; }
  .lang-switcher--dark .lang-switcher__option.is-active { color: var(--color-white); background: var(--color-navy); opacity: 1; }
  .lang-switcher__sep { opacity: 0.38; }
</style>
