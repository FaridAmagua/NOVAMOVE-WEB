---
import { localizedPath, type Locale } from '../utils/i18n';

interface Props {
  variant?: 'light' | 'white';
  size?: number;
  withWordmark?: boolean;
  mark?: boolean;
  locale: Locale;
}

const { size = 44, mark = true, locale } = Astro.props;
---

<a href={localizedPath(locale, '/')} class="logo" aria-label="Global Move - Inicio">
  {mark && (
    <img
      src="/brand/wordmark-light.png"
      alt="GLOBAL.MOVE"
      width="320"
      height="50"
      class="logo__mark"
      style={`height:${Math.max(size, 38)}px`}
      loading="eager"
      decoding="async"
    />
  )}
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .logo__mark {
    display: block;
    width: auto;
    flex-shrink: 0;
    transition: opacity var(--dur-base) var(--ease);
  }

  .logo:hover .logo__mark {
    opacity: 0.85;
  }

  @media (max-width: 540px) {
    .logo__mark {
      max-height: 38px;
    }
  }
</style>
