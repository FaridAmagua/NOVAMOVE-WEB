---
import Logo from './Logo.astro';
import { t, localizedPath, type Locale } from '../utils/i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;

const year = new Date().getFullYear();
const site = t(locale, 'site.name');
const tagline = t(locale, 'site.tagline');

const services = [
  { key: 'services.items.relocation.title', href: 'services' },
  { key: 'services.items.rentals.title', href: 'services' },
  { key: 'services.items.global.title', href: 'services' },
  { key: 'services.items.concierge.title', href: 'services' },
].map(s => ({ label: t(locale, s.key), href: localizedPath(locale, `/${s.href}`) }));

const company = [
  { label: t(locale, 'nav.about'), href: localizedPath(locale, '/about') },
  { label: t(locale, 'nav.blog'), href: localizedPath(locale, '/blog') },
  { label: t(locale, 'nav.contact'), href: localizedPath(locale, '/contact') },
];

const resources = [
  { label: t(locale, 'nav.destinations'), href: localizedPath(locale, '/destinations') },
  { label: t(locale, 'blog.title'), href: localizedPath(locale, '/blog') },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo locale={locale} variant="white" withWordmark={true} size={48} />
        <p class="site-footer__tagline">{tagline}</p>
        <div class="site-footer__contact">
          <a href="mailto:hello@globalmove.com">hello@globalmove.com</a>
          <a href="tel:+34600123456">+34 600 123 456</a>
        </div>
      </div>

      <div class="site-footer__col">
        <h4 class="site-footer__heading">{t(locale, 'footer.company')}</h4>
        <ul>
          {company.map(item => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="site-footer__col">
        <h4 class="site-footer__heading">{t(locale, 'footer.resources')}</h4>
        <ul>
          {resources.map(item => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="site-footer__col">
        <h4 class="site-footer__heading">{site}</h4>
        <ul>
          {services.map(item => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="site-footer__col">
        <h4 class="site-footer__heading">{t(locale, 'footer.followUs')}</h4>
        <ul class="site-footer__social">
          <li><a href="#" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          </a></li>
          <li><a href="#" aria-label="LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 13v4"/></svg>
          </a></li>
          <li><a href="#" aria-label="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {site}. {t(locale, 'footer.rights')}</p>
      <ul class="site-footer__legal">
        <li><a href="#">{t(locale, 'footer.privacy')}</a></li>
        <li><a href="#">{t(locale, 'footer.terms')}</a></li>
        <li><a href="#">{t(locale, 'footer.cookies')}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy-900);
    color: var(--text-on-dark-soft);
    padding-block: 5rem 1.5rem;
    font-size: 0.9rem;
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1.4fr repeat(4, 1fr);
    gap: 3rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .site-footer__brand { max-width: 320px; }
  .site-footer__tagline {
    margin-top: 1.2rem;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    font-weight: 500;
  }
  .site-footer__contact {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .site-footer__contact a { transition: color var(--dur-base) var(--ease); }
  .site-footer__contact a:hover { color: var(--color-gold); }

  .site-footer__heading {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    font-weight: 600;
    margin-bottom: 1.2rem;
  }

  .site-footer__col ul { display: flex; flex-direction: column; gap: 0.7rem; }
  .site-footer__col a { color: var(--text-on-dark-soft); transition: color var(--dur-base) var(--ease); }
  .site-footer__col a:hover { color: var(--color-white); }

  .site-footer__social {
    display: flex;
    gap: 0.85rem;
  }
  .site-footer__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px; height: 38px;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 50%;
    transition: all var(--dur-base) var(--ease);
  }
  .site-footer__social a:hover {
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-navy);
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .site-footer__bottom p { font-size: 0.82rem; opacity: 0.7; }
  .site-footer__legal {
    display: flex;
    gap: 1.5rem;
  }
  .site-footer__legal a { font-size: 0.82rem; opacity: 0.7; transition: opacity var(--dur-base) var(--ease); }
  .site-footer__legal a:hover { opacity: 1; color: var(--color-gold); }

  @media (max-width: 960px) {
    .site-footer__top {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
    .site-footer__brand { grid-column: 1 / -1; max-width: none; }
  }

  @media (max-width: 540px) {
    .site-footer__top { grid-template-columns: 1fr; }
  }
</style>