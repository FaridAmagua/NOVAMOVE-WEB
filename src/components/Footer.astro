---
import { type Locale } from '../utils/i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;

const year = new Date().getFullYear();
const companyName = 'Serhant Real Estate, Inc.';

const socials = [
  {
    label: 'Facebook',
    href: '#',
    icon: '<path d="M14.2 8.7h2.1V5.3c-.4-.1-1.6-.2-3-.2-3 0-5.1 1.8-5.1 5.2v2.9H4.8V17h3.4v8h4.2v-8h3.3l.5-3.8h-3.8v-2.5c0-1.1.3-2 1.8-2Z"/>',
  },
  {
    label: 'Instagram',
    href: '#',
    icon: '<rect x="5.5" y="5.5" width="13" height="13" rx="3.5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="16" cy="8" r="1" />',
  },
  {
    label: 'LinkedIn',
    href: '#',
    icon: '<path d="M6.2 10h3.2v8.8H6.2V10Zm1.6-4.4a1.85 1.85 0 1 1 0 3.7 1.85 1.85 0 0 1 0-3.7ZM11 10h3.1v1.2h.1c.4-.7 1.4-1.5 2.9-1.5 3.1 0 3.7 2 3.7 4.7v4.4h-3.2v-3.9c0-.9 0-2.1-1.3-2.1s-1.5 1-1.5 2.1v4H11V10Z"/>',
  },
  {
    label: 'X',
    href: '#',
    icon: '<path d="M15 11.1 20.5 5h-1.9l-4.4 4.9L10.7 5H5l6 8.1L5.2 19.5H7l4.8-5.3 3.8 5.3h5.7L15 11.1Zm-2 2.2-.8-1.1-4-5.6h1.7l3.3 4.6.8 1.1 4.3 6h-1.7L13 13.3Z"/>',
  },
  {
    label: 'TikTok',
    href: '#',
    icon: '<path d="M15 4.7c.4 2.3 1.7 3.7 4 3.9v3.1c-1.4.1-2.7-.3-3.9-1.1v5.8c0 3-1.8 4.9-4.6 4.9-2.7 0-4.7-1.9-4.7-4.5 0-2.8 2.3-4.8 5.4-4.4v3.2c-1.3-.4-2.3.2-2.3 1.2 0 .8.7 1.4 1.6 1.4 1 0 1.5-.6 1.5-1.8V4.7h3Z"/>',
  },
  {
    label: 'YouTube',
    href: '#',
    icon: '<path d="M21.4 8.2a3 3 0 0 0-2.1-2.1C17.5 5.6 12 5.6 12 5.6s-5.5 0-7.3.5a3 3 0 0 0-2.1 2.1A31 31 0 0 0 2.1 12c0 1.3.1 2.7.5 3.8a3 3 0 0 0 2.1 2.1c1.8.5 7.3.5 7.3.5s5.5 0 7.3-.5a3 3 0 0 0 2.1-2.1c.4-1.1.5-2.5.5-3.8s-.1-2.7-.5-3.8ZM10.2 15.1V8.9l5.4 3.1-5.4 3.1Z"/>',
  },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <a class="site-footer__wordmark" href={`/${locale}/`} aria-label="Global Move - Inicio">
      GLOBAL.MOVE
    </a>
    <p class="site-footer__copyright">
      © {year} {companyName} All Rights Reserved.
    </p>
    <ul class="site-footer__social" aria-label="Social links">
      {socials.map((social) => (
        <li>
          <a href={social.href} aria-label={social.label}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={social.icon}></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: #fff;
    color: #001a72;
    padding: clamp(2.1rem, 5vw, 3.2rem) 0;
  }

  .site-footer__inner {
    border-top: 1px solid rgba(0, 0, 0, 0.2);
    padding-top: clamp(1.8rem, 4vw, 2.25rem);
  }

  .site-footer__wordmark {
    display: inline-block;
    color: #001a72;
    font-family: var(--font-display, var(--font-sans));
    font-size: clamp(1.38rem, 5.7vw, 1.75rem);
    line-height: 1;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-footer__copyright {
    margin: 1.05rem 0 0;
    color: #000;
    font-family: "Montserrat", var(--font-sans), sans-serif;
    font-size: 12px;
    line-height: 1.35;
    font-weight: 500;
    letter-spacing: 0;
  }

  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.9rem;
  }

  .site-footer__social a {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: 50%;
    color: #000;
    background: #fff;
    transition: border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .site-footer__social a:hover {
    color: #001a72;
    border-color: rgba(0, 26, 114, 0.45);
    transform: translateY(-1px);
  }

  .site-footer__social svg {
    width: 17px;
    height: 17px;
    display: block;
    fill: currentColor;
  }

  @media (max-width: 540px) {
    .site-footer {
      padding-block: 2rem 2.6rem;
    }

    .site-footer__copyright {
      max-width: 20rem;
      font-size: 12px;
    }

    .site-footer__social {
      gap: 0.5rem;
      margin-top: 1.75rem;
    }

    .site-footer__social a {
      width: 40px;
      height: 40px;
    }
  }
</style>
