---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, supportedLocales, type Locale, stripLocale } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
  transparentHeader?: boolean;
  /** Hide the global header (used by full-bleed pages like 404). */
  hideHeader?: boolean;
  /** Hide the global footer (used by full-bleed pages like 404). */
  hideFooter?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-image.jpg',
  ogType = 'website',
  structuredData,
  noindex = false,
  transparentHeader = false,
  hideHeader = false,
  hideFooter = false,
} = Astro.props;

// Resolve locale: prefer Astro.params.locale (set by [locale]/ routes),
// fall back to pathname detection for safety.
const paramLocale = Astro.params.locale as Locale | undefined;
const seg = Astro.url.pathname.split('/').filter(Boolean)[0];
const locale: Locale = paramLocale ?? ((seg === 'en' || seg === 'es') ? seg : 'es');

const path = Astro.url.pathname;
const asText = (value: string | string[]) => Array.isArray(value) ? value.join(' ') : value;
const siteTitle = asText(t(locale, 'site.name'));
const siteTagline = asText(t(locale, 'site.tagline'));
const defaultDesc = asText(t(locale, 'site.description'));
const fullTitle = title ? `${title} · ${siteTitle}` : `${siteTitle} · ${siteTagline}`;
const finalDesc = description ?? defaultDesc;
const site = Astro.site ?? new URL('https://globalmove.agency');
const siteOrigin = new URL(site).origin;

const withTrailingSlash = (pathname: string) => {
  const clean = pathname.split('?')[0]?.replace(/\/+$/, '') || '';
  return clean ? `${clean}/` : '/';
};

// Canonicals match Astro trailingSlash: "always".
const canonicalPath = withTrailingSlash(path);
const canonical = new URL(canonicalPath, site).toString();

const restOfPath = withTrailingSlash(stripLocale(path)); // e.g. "/services/"
const buildAlt = (loc: Locale) => {
  const suffix = restOfPath === '/' ? '' : restOfPath;
  return new URL(withTrailingSlash(`/${loc}${suffix}`), site).toString();
};

const baseStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: siteTitle,
    url: siteOrigin,
    logo: new URL('/brand/global-move-icon-gold.png', site).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteTitle,
    url: siteOrigin,
    inLanguage: locale,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${siteOrigin}/${locale}/properties/?dest={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: fullTitle,
    description: finalDesc,
    url: canonical,
    inLanguage: locale,
    isPartOf: {
      '@type': 'WebSite',
      name: siteTitle,
      url: siteOrigin,
    },
  },
];
const extraStructuredData = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const structuredDataItems = [...baseStructuredData, ...extraStructuredData];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#001A72" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <title>{fullTitle}</title>
    <meta name="description" content={finalDesc} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={finalDesc} />
    <meta property="og:image" content={new URL(ogImage, site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_ES'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={finalDesc} />
    <meta name="twitter:image" content={new URL(ogImage, site).toString()} />

    <!-- Hreflang alternates -->
    {supportedLocales.map(loc => (
      <link rel="alternate" hreflang={loc} href={buildAlt(loc)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={buildAlt('es')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400..900;1,400..900&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400..900;1,400..900&display=swap" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400..900;1,400..900&display=swap" />
    </noscript>
    {structuredDataItems.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <ViewTransitions fallback="swap" />
  </head>
  <body class:list={[{ 'no-header': hideHeader }]}>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    {!hideHeader && <Header locale={locale} currentPath={path} transparent={transparentHeader} />}
    <main id="main">
      <slot />
    </main>
    {!hideFooter && <Footer locale={locale} />}

    <script>
      import '../scripts/enhance.ts';
    </script>

    <!-- Inline header-scroll handler: uses IntersectionObserver (more
         reliable than scroll events on mobile Safari/Android Chrome). -->
    <script is:inline>
      (function() {
        const headerWindow = window;
        if (headerWindow.__globalMoveHeaderScrollVersion === 'v2') return;
        headerWindow.__globalMoveHeaderScrollVersion = 'v2';

        let observer = null;
        let scrollHandler = null;

        const closeMenus = () => {
          document.querySelectorAll('.site-header.is-menu-open').forEach((el) => {
            el.classList.remove('is-menu-open');
          });
          document.querySelectorAll('.site-header__toggle.is-open, .site-drawer.is-open').forEach((el) => {
            el.classList.remove('is-open');
            if (el.classList.contains('site-header__toggle')) el.setAttribute('aria-expanded', 'false');
            if (el.classList.contains('site-drawer')) el.setAttribute('aria-hidden', 'true');
          });
          document.body.style.overflow = '';
        };

        const setupObserver = () => {
          closeMenus();
          if (observer) observer.disconnect();
          if (scrollHandler) window.removeEventListener('scroll', scrollHandler);
          observer = null;
          scrollHandler = null;

          const header = document.querySelector('.site-header');
          if (!header) return;
          if (header.dataset.transparent !== 'true') {
            header.classList.remove('is-scrolled');
            return;
          }
          // Sentinel: a 1px line just below the header. When it scrolls
          // out of viewport, the header becomes solid.
          let sentinel = document.getElementById('header-scroll-sentinel');
          if (!sentinel) {
            sentinel = document.createElement('div');
            sentinel.id = 'header-scroll-sentinel';
            sentinel.style.cssText = 'position:absolute;top:60px;left:0;width:1px;height:1px;pointer-events:none;';
            document.body.prepend(sentinel);
          }
          if (observer) observer.disconnect();
          observer = new IntersectionObserver(
            ([entry]) => {
              header.classList.toggle('is-scrolled', !entry.isIntersecting);
            },
            { rootMargin: '0px 0px 0px 0px', threshold: 0 }
          );
          observer.observe(sentinel);
          // Also keep scroll fallback for top-of-page <30px edge case
          scrollHandler = () => {
            header.classList.toggle('is-scrolled', window.scrollY > 60);
          };
          window.addEventListener('scroll', scrollHandler, { passive: true });
          scrollHandler();
        };

        setupObserver();
        document.addEventListener('astro:page-load', setupObserver);
        document.addEventListener('astro:before-swap', closeMenus);
      })();
    </script>

    <style is:global>
      /* View transition defaults — fade by default, slide on named groups */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 320ms;
      }
    </style>
  </body>
</html>
