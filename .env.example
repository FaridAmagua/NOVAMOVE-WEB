# PayPal.me handle (for scripts/generate-paypal-link.mjs)
PAYPAL_ME_USER=pulseprojectxES

# Nivora catalog API (consumed at build time by src/data/nivora-catalog.ts)
# ⚠️ Todas estas variables son OBLIGATORIAS en producción.
#    Si falta alguna o Nivora falla, el build falla con error explícito.
NIVORA_API_URL=https://api.nivora.com
NIVORA_SITE_KEY=replace-with-your-site-key
NIVORA_CATALOG_TOKEN=replace-with-your-catalog-token
# Opcional: override del endpoint si Nivora expone otra ruta
# NIVORA_ENDPOINT_OVERRIDE=https://api.nivora.com/v2/properties
# Opcional: forzar re-fetch en cada build (ignora cache)
# NIVORA_FORCE_REFRESH=1
