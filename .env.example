# PayPal.me handle (for scripts/generate-paypal-link.mjs)
PAYPAL_ME_USER=pulseprojectxES

# Nivora catalog API (consumida en build por src/data/nivora-catalog.ts)
# ⚠️ Todas estas variables son OBLIGATORIAS en producción.
#    Si falta alguna o Nivora falla, el build falla con error explícito.
NIVORA_API_URL=https://api-nivora.decotea.es
NIVORA_SITE_KEY=glovalmove
NIVORA_CATALOG_TOKEN=replace-with-real-token
